# Copiar a .env.local (desarrollo) o .env (servidor) y completar con valores propios.
# Este archivo solo contiene ejemplos ficticios. Nunca escribas credenciales reales aca.

# ---- Aplicacion ----
NODE_ENV=development
PORT=3000

# ---- Base de datos (Prisma / PostgreSQL) ----
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/kiosco?schema=public

# ---- Autenticacion ----
# Generar uno propio, por ejemplo: openssl rand -base64 32
JWT_SECRET=reemplazar-por-un-secreto-generado

# ---- docker-compose (entorno local) ----
POSTGRES_USER=kiosco
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=kiosco

# ---- tools/scrap.py (scraper OpenFoodFacts, base independiente) ----
OPENFOOD_DB_NAME=openfood
OPENFOOD_DB_USER=postgres
OPENFOOD_DB_PASSWORD=cambiar-en-local
OPENFOOD_DB_HOST=localhost
OPENFOOD_DB_PORT=5432
