# Plantilla de variables de entorno. NUNCA escribas credenciales reales aca:
# este archivo se versiona.
#
#   desarrollo   -> copiar a .env.local
#   pruebas      -> .env.test (lo lee vitest; ver tests/setup.ts)
#   staging      -> .env en el servidor, con SU PROPIA base y SU PROPIO secreto
#   produccion   -> .env en el servidor
#
# Staging y produccion NO comparten nada: ni base, ni secreto, ni puerto.
# Ver docs/STAGING_RUNBOOK.md.
#
# La aplicacion COMPRUEBA las obligatorias al arrancar y se niega a levantar si
# faltan o son debiles (src/server/env.ts). No arranca a medias.

# ===========================================================================
# OBLIGATORIAS — sin estas, la aplicacion no arranca
# ===========================================================================

# Cadena de conexion de PostgreSQL.
#
#   desarrollo   postgresql://kiosco_dev:...@127.0.0.1:5433/kiosco_dev?schema=public
#   pruebas      .../kiosco_test   <- OTRA base: la suite la vacia entera
#   staging      .../kiosco_staging
#   produccion   .../kiosco
#
# El usuario de la aplicacion NO deberia ser superusuario. Necesita, ademas,
# poder crear objetos en el esquema para que corran las migraciones; hoy en
# produccion NO puede. Ver docs/PRODUCTION_CURRENT_STATE.md.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/kiosco?schema=public

# Secreto de firma de la sesion. MINIMO 32 caracteres.
#
# Uno por entorno, distintos entre si: con el mismo secreto, un token emitido
# en staging abre sesion en produccion.
#
# Generar:  openssl rand -base64 48
#
# Rotarlo cierra todas las sesiones abiertas. Es intencional y hay que elegir
# cuando. Ver docs/SECRET_ROTATION_PLAN.md.
JWT_SECRET=reemplazar-por-un-secreto-generado-de-al-menos-32-caracteres

# ===========================================================================
# OPCIONALES — tienen valor por omision
# ===========================================================================

# `production` en staging TAMBIEN: staging tiene que correr el mismo modo que
# produccion o no prueba lo mismo. Lo que los distingue es la base y el
# dominio, no el modo.
NODE_ENV=development

# Puerto de la aplicacion. Produccion 3099, staging OTRO (p. ej. 3098).
PORT=3000

# Nombre del comercio, visible en la interfaz. No es un secreto.
NEXT_PUBLIC_COMMERCE_NAME=Kiosco

# ===========================================================================
# HERRAMIENTAS — no las usa la aplicacion en ejecucion
# ===========================================================================

# docker-compose del entorno local.
POSTGRES_USER=kiosco
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=kiosco

# scripts/rehearsal.ts: donde estan pg_dump y psql, si no estan en el PATH.
PG_BIN=

# scripts/verificar-pwa.mjs y scripts/screenshots.ts.
PWA_CHECK_URL=http://localhost:3100
SCREENSHOT_BASE_URL=http://localhost:3000
SCREENSHOT_USER=
SCREENSHOT_PASSWORD=

# npm run smoke:staging / smoke:production. Ver docs/STAGING_RUNBOOK.md.
SMOKE_BASE_URL=
SMOKE_USER=
SMOKE_PASSWORD=

# tools/scrap.py (scraper de OpenFoodFacts, base independiente).
OPENFOOD_DB_NAME=openfood
OPENFOOD_DB_USER=postgres
OPENFOOD_DB_PASSWORD=cambiar-en-local
OPENFOOD_DB_HOST=localhost
OPENFOOD_DB_PORT=5432
