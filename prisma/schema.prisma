generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id             Int                    @id @default(autoincrement())
  name           String                 @unique
  address        String?
  createdAt      DateTime               @default(now())
  email          String?
  phone          String?
  products       BranchStock[]
  sales          Sale[]
  users          User[]
  cashMovements  CashRegisterMovement[]
  cashCounts     CashCount[]
  productsList   Product[]
  auditLogs      AuditLog[]
  cashShifts     CashShift[]
  stockMovements StockMovement[]

  /// Efectivo acumulado desde que se instalo el sistema.
  ///
  /// YA NO DECIDE NADA. Desde la Fase 3 el arqueo compara contra el turno, la
  /// cabecera muestra el turno y el cierre calcula sobre el turno. Esto queda
  /// como dato historico de la sucursal --hay dos anios apoyados en el-- y se
  /// sigue actualizando, pero ningun camino lo consulta para decidir.
  /// Ver docs/CASH_SHIFT_MODEL.md.
  ///
  /// `Decimal(14,2)` desde la Fase 3: en `Float` la suma de ventas y la
  /// reversion de una anulacion no volvian al mismo numero.
  currentCash Decimal @default(0) @db.Decimal(14, 2)

  /// Si hace falta un turno abierto para poder vender.
  ///
  /// Verdadero por omision: es el punto de tener turnos. Se puede apagar por
  /// sucursal para dar salida a un local que todavia no adopto el flujo, sin
  /// que el sistema le mienta diciendo que la caja "cuadra".
  requireOpenShift Boolean @default(true)

  /// Diferencia de arqueo a partir de la cual el cierre necesita autorizacion.
  ///
  /// Cero significa sin umbral. Es un numero y una comprobacion, no un sistema
  /// de reglas: cuando haga falta algo mas se disenia entonces.
  cashDifferenceThreshold Decimal @default(0) @db.Decimal(14, 2)
}

/// Turno de caja: se abre contando el cajon y se cierra volviendolo a contar.
///
/// Reemplaza al acumulado historico como respuesta a la unica pregunta que se
/// hace en el mostrador: "empece con esto, paso esto, tengo que tener esto,
/// ¿lo tengo?". Ver docs/CASH_SHIFT_MODEL.md.
model CashShift {
  id       Int @id @default(autoincrement())
  branchId Int

  openedById Int
  closedById Int?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  /// Lo que habia en el cajon al abrir. NO se puede editar despues: un saldo
  /// inicial editable convierte cualquier faltante en un problema de tipeo.
  openingAmount Decimal @db.Decimal(14, 2)

  /// Lo que el sistema esperaba AL CERRAR. Null mientras el turno esta
  /// abierto, y a proposito: durante el turno el esperado se DERIVA de los
  /// movimientos. Guardarlo antes obligaria a mantenerlo sincronizado en cada
  /// venta, y el dia que un camino se olvide deja de significar nada --que es
  /// exactamente lo que pasaba con `Branch.currentCash`--.
  expectedAmount Decimal? @db.Decimal(14, 2)

  /// Lo que se conto fisicamente al cerrar.
  countedAmount Decimal? @db.Decimal(14, 2)

  /// contado - esperado. Positivo sobra, negativo falta.
  difference Decimal? @db.Decimal(14, 2)

  /// 'open' | 'closed' | 'legacy'.
  ///
  /// `legacy` es el turno que crea la migracion para colgarle todo lo anterior
  /// a que existieran los turnos. No se cierra, no se reabre y no cuenta como
  /// turno abierto.
  status String @default("open")

  openingNotes String?
  closingNotes String?

  /// Quien autorizo una diferencia por encima del umbral de la sucursal.
  authorizedById Int?

  branch       Branch @relation(fields: [branchId], references: [id])
  openedBy     User   @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy     User?  @relation("ShiftClosedBy", fields: [closedById], references: [id])
  authorizedBy User?  @relation("ShiftAuthorizedBy", fields: [authorizedById], references: [id])

  movements CashRegisterMovement[]
  counts    CashCount[]

  @@index([branchId, openedAt])
  @@index([branchId, status])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  password  String
  name      String
  roleId    Int
  branchId  Int
  createdAt DateTime @default(now())
  username  String   @unique

  /// Un usuario dado de baja conserva su historial pero no puede iniciar sesion.
  /// Nunca se borra: los registros financieros lo referencian.
  isActive Boolean @default(true)

  /// Se incrementa para invalidar todas las sesiones abiertas del usuario
  /// (cambio de contrasena, baja, revocacion manual). El JWT lleva el valor
  /// con el que fue emitido; si no coincide con el actual, la sesion se rechaza.
  sessionVersion Int @default(0)

  logs             AuditLog[]
  costChanges      ProductCostHistory[]
  sales            Sale[]                 @relation("SaleCreatedBy")
  canceledSales    Sale[]                 @relation("SaleCanceledBy")
  stockChecks      StockCheck[]
  stockMovements   StockMovement[]
  cashMovements    CashRegisterMovement[] // ← relación inversa agregada
  shiftsOpened     CashShift[]            @relation("ShiftOpenedBy")
  shiftsClosed     CashShift[]            @relation("ShiftClosedBy")
  shiftsAuthorized CashShift[]            @relation("ShiftAuthorizedBy")
  branch           Branch                 @relation(fields: [branchId], references: [id])
  role             Role                   @relation(fields: [roleId], references: [id])
  cashCounts       CashCount[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id   Int    @id @default(autoincrement())
  name String

  /// CONGELADA desde la Fase 3B. No se lee y no se escribe.
  ///
  /// Los codigos de barras viven en `ProductBarcode`, que permite varios por
  /// producto. Esta columna conserva su valor y su indice unico por una sola
  /// razon: la regla 2 de docs/DATABASE_MIGRATION_STRATEGY.md exige al menos un
  /// despliegue entre dejar de usar una columna y borrarla. Se borra en la Fase
  /// 3C. Ver docs/PHASE3_BARCODES.md.
  barcode String? @unique

  description String?
  supplierId  Int?
  categoryId  Int

  /// Precio de venta, POR UNIDAD DE VENTA. Dos decimales: es lo que se cobra.
  /// Un producto con `saleUnit = KG` a `9800.00` vale $9.800 el kilo.
  price Decimal @db.Decimal(14, 2)

  /// Cuanto cuesta comprarlo. NULL significa "no sabemos".
  ///
  /// Nulo y no cero, y sobre todo no igual al precio: un margen de cero
  /// inventado se ve exactamente igual que un margen de cero real, y alguien
  /// va a tomar una decision de precios mirandolo. Todo el catalogo migrado
  /// arranca en NULL.
  ///
  /// Cuatro decimales porque el costo se DERIVA de una division: una caja de 8
  /// a $12.345 da $1.543,125 por unidad. Ver docs/PHASE3_MONEY_MIGRATION.md.
  ///
  /// Solo sale hacia la API para quien tenga `products.cost.view`. El endpoint
  /// que usa la caja NUNCA lo incluye.
  cost Decimal? @db.Decimal(14, 4)

  /// Unidad en la que se VENDE: UNIT | KG | G | L | ML.
  ///
  /// Es la unidad de `price`, de `minimumStock`, de `BranchStock.quantity`, de
  /// `SaleItem.quantity` y de todo el libro de movimientos del producto. Por
  /// eso NO SE PUEDE CAMBIAR cuando el producto ya tiene historial: hay un
  /// disparador en la base que lo impide, porque cambiarla reescribiria en
  /// silencio el significado de todo su pasado.
  saleUnit String @default("UNIT")

  /// Unidad en la que se COMPRA: las cinco de venta mas PACK y BOX.
  ///
  /// PACK y BOX existen solo de este lado. Como unidad de venta no aportan
  /// nada --un six-pack que se vende entero se vende por unidad, y la unidad es
  /// el six-pack--; como unidad de compra son el unico modo de que
  /// `unitsPerPurchaseUnit` se pueda leer.
  purchaseUnit String @default("UNIT")

  /// Cuantas unidades de venta trae una unidad de compra. Una caja de 8: `8`.
  ///
  /// Preparado para la Fase 3C, que es donde se usa de verdad. Decimal porque
  /// tambien es una cantidad: "una caja trae 12,5 kg" es tan valido como "una
  /// caja trae 8 unidades".
  unitsPerPurchaseUnit Decimal @default(1) @db.Decimal(14, 3)

  /// Sin uso. Quedo de una migracion de mayo de 2025 y no se borra: quitar
  /// una columna en una migracion que corre en el servidor es exactamente lo
  /// que docs/DATABASE_MIGRATION_STRATEGY.md prohibe. Deuda anotada.
  value    Int?
  branchId Int

  /// Un producto dado de baja sale del catalogo de venta pero conserva su
  /// historial. Nunca se borra: los items de venta lo referencian, y borrarlo
  /// falsearia los reportes de meses anteriores.
  isActive Boolean @default(true)

  /// Cantidad por debajo de la cual hay que reponer, EN LA UNIDAD DE VENTA.
  ///
  /// Cero significa SIN MINIMO CONFIGURADO, y con cero el estado `LOW` no se
  /// cumple nunca: `quantity > 0 && quantity <= 0` es imposible. Es el valor
  /// que la migracion le pone a todo el catalogo existente, a proposito: el
  /// sistema no sabe cuantos fideos quiere tener este almacen y no lo inventa.
  ///
  /// `Decimal(14,3)` desde la Fase 3B: el minimo de un producto por peso son
  /// 3,5 kg, no 3 ni 4. Tiene que estar en el mismo tipo y en la misma unidad
  /// que el stock, que es la unica forma de que `stock <= minimo` signifique
  /// algo.
  ///
  /// El estado (OK / LOW / OUT) NO se guarda: se calcula al leer. Ver
  /// docs/INVENTORY_LEDGER.md.
  minimumStock Decimal @default(0) @db.Decimal(14, 3)

  stocks      BranchStock[]
  saleItems   SaleItem[]
  movements   StockMovement[]
  barcodes    ProductBarcode[]
  costHistory ProductCostHistory[]
  category    Category             @relation(fields: [categoryId], references: [id])
  supplier    Supplier?            @relation(fields: [supplierId], references: [id])
  branch      Branch               @relation(fields: [branchId], references: [id])

  /// La caja busca por sucursal y por estado en cada tecla.
  @@index([branchId, isActive])
}

/// Codigos de barras de un producto. Uno principal y los alternativos.
///
/// Un producto puede tener varios: el mismo yogur cambia de codigo entre
/// partidas, y el proveedor a veces manda el pack con un codigo distinto al de
/// la unidad. Con un solo codigo, el lector no encuentra la mitad de la
/// mercaderia y el cajero termina buscando por nombre.
///
/// Dos reglas, las dos en la base: un codigo apunta a UN producto en todo el
/// sistema, y un producto tiene UN codigo principal (indice unico parcial).
model ProductBarcode {
  id        Int @id @default(autoincrement())
  productId Int

  /// El codigo tal cual lo devuelve el lector. Se recorta y nada mas: pasarlo
  /// a mayusculas reescribiria codigos existentes, y para un lector dos
  /// codigos que difieren en mayusculas son dos codigos distintos.
  code String

  /// El que se muestra en la ficha y en los listados. Uno solo por producto.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  /// CASCADE, a diferencia del libro y del historial de costos: un codigo de
  /// barras no es historia, es un atributo. Sin el producto no significa nada,
  /// y conservarlo impediria borrar un producto cargado por error.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([code], map: "ProductBarcode_code_key")
  @@index([productId])
}

/// Cada cambio de costo de un producto. Inmutable.
///
/// Mismo criterio que `StockMovement`: hay un disparador en la base que impide
/// editar y borrar. Un historial de costos editable no sirve para explicar por
/// que subio un precio.
///
/// El ALTA de un producto con costo NO escribe fila aca. Un historial registra
/// CAMBIOS --por eso tiene `previousCost`, que en un alta no habria que
/// poner--, y el costo con el que nace un producto ya queda en la bitacora de
/// su creacion.
model ProductCostHistory {
  id        Int @id @default(autoincrement())
  productId Int

  /// NULL cuando el producto no tenia costo cargado, que es de donde parte
  /// todo el catalogo migrado.
  previousCost Decimal? @db.Decimal(14, 4)
  newCost      Decimal  @db.Decimal(14, 4)

  /// Preparados para la Fase 3C, cuando una recepcion de mercaderia pueda
  /// cambiar el costo sola. En esta fase son siempre NULL: no hay compras.
  ///
  /// `purchaseId` no tiene clave foranea porque la tabla `Purchase` todavia no
  /// existe. Se agrega en la 3C, cuando haya a que apuntar.
  supplierId Int?
  purchaseId Int?

  userId Int

  /// Obligatorio. Un cambio de costo sin motivo no se puede auditar despues.
  reason String

  createdAt DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([userId])
}

/// Libro de movimientos de stock. Inmutable.
///
/// El stock deja de ser un numero y pasa a ser el saldo de un libro:
///
///   para todo producto:  suma(StockMovement.quantity) == BranchStock.quantity
///
/// `BranchStock.quantity` sigue existiendo --leer un saldo tiene que costar una
/// fila, no una suma de dos anios-- pero ya no es la fuente de la verdad: es el
/// saldo materializado de esta tabla.
///
/// Ninguna fila se edita ni se borra. Hay un disparador en la base que lo
/// impide, no solo una convencion. Los errores se corrigen con otro movimiento.
/// Ver docs/INVENTORY_LEDGER.md.
model StockMovement {
  id        Int @id @default(autoincrement())
  branchId  Int
  productId Int

  /// INITIAL | SALE | SALE_CANCEL | MANUAL_ADJUSTMENT | LOSS | BREAKAGE |
  /// INTERNAL_USE | PURCHASE_RECEIPT (reservado, Fase 3C).
  ///
  /// La base comprueba el tipo Y el signo que le corresponde: una venta que
  /// aumente el stock no es un error que haya que buscar, es una fila que
  /// PostgreSQL rechaza.
  type String

  /// Delta CON SIGNO. Una venta de 2 escribe -2; su anulacion, +2.
  ///
  /// Firmado y no absoluto para que `SUM(quantity)` sea la reconstruccion del
  /// stock sin que la consulta tenga que conocer la tabla de signos.
  ///
  /// `Decimal(14,3)` desde la Fase 3B. En `Float` la restriccion de abajo
  /// --que los tres numeros concuerden-- fallaria sola: `0.1 + 0.2` no da
  /// `0.3` en binario, y un ajuste de 100 g sobre 200 g seria una fila que
  /// PostgreSQL rechaza. Ver docs/PHASE3_QUANTITY_MIGRATION.md.
  quantity Decimal @db.Decimal(14, 3)

  /// Saldo antes y despues, en la unidad de venta del producto. Redundantes
  /// --el tercero se deduce de los otros dos-- y guardados igual: asi una fila
  /// del historial se lee sin recorrer las anteriores. La base obliga a que los
  /// tres numeros concuerden.
  previousQuantity  Decimal @db.Decimal(14, 3)
  resultingQuantity Decimal @db.Decimal(14, 3)

  /// De donde vino: 'Sale' + id de la venta, 'BranchStock' + id del ajuste.
  /// No es clave foranea --apunta a tablas distintas segun el tipo-- y por eso
  /// solo la escribe el servidor.
  referenceType String?
  referenceId   Int?

  /// Quien lo provoco. Siempre de la sesion verificada.
  userId Int

  /// Motivo declarado. Obligatorio en los ajustes; nulo en ventas y
  /// anulaciones, donde el motivo vive en la venta.
  reason String?

  createdAt DateTime @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  /// El historial de la sucursal, que es lo que abre la pantalla.
  @@index([branchId, createdAt])
  /// La ficha de un producto.
  @@index([productId, createdAt])
  /// Filtrar por tipo dentro de una sucursal.
  @@index([branchId, type, createdAt])
  /// "Que movio la venta #4832".
  @@index([referenceType, referenceId])
  /// Filtrar por quien.
  @@index([userId])
}

model BranchStock {
  id        Int @id @default(autoincrement())
  branchId  Int
  productId Int

  /// Saldo materializado del libro, EN LA UNIDAD DE VENTA del producto.
  ///
  /// `Decimal(14,3)` desde la Fase 3B: 3,500 en un producto por kilo son tres
  /// kilos y medio. La unidad NO esta aca sino en `Product.saleUnit`, y por eso
  /// esa columna no se puede cambiar una vez que el producto tiene historial:
  /// cambiarla reescribiria el significado de todo su pasado en silencio.
  quantity Decimal @db.Decimal(14, 3)

  branch  Branch       @relation(fields: [branchId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  checks  StockCheck[] // back-relation para StockCheck

  @@unique([branchId, productId])
}

model StockCheck {
  id      Int      @id @default(autoincrement())
  stockId Int
  userId  Int
  date    DateTime @default(now())

  stock BranchStock @relation(fields: [stockId], references: [id])
  user  User        @relation(fields: [userId], references: [id])

  @@unique([stockId, userId, date])
}

model Supplier {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  contact     String?
  products    Product[]
  costChanges ProductCostHistory[]
}

model Sale {
  id         Int      @id @default(autoincrement())
  userId     Int
  branchId   Int
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  isVerified Boolean  @default(false)

  /// "completed" | "canceled". Una venta nunca se borra: se anula.
  status       String    @default("completed")
  canceledAt   DateTime?
  canceledById Int?
  cancelReason String?

  /// Total cobrado.
  ///
  /// Se guarda y no se deriva de los items porque es contra ESTE numero que se
  /// comprueba la suma de los pagos. Derivarlo en cada lectura significaria
  /// que la comprobacion "suma de pagos == total" depende de recalcular el
  /// total igual que cuando se cobro --mismo redondeo, mismo orden-- y eso es
  /// exactamente lo que no se puede garantizar dos anios despues.
  total Decimal @default(0) @db.Decimal(14, 2)

  items         SaleItem[]
  payments      SalePayment[]
  cashMovements CashRegisterMovement[]
  user          User                   @relation("SaleCreatedBy", fields: [userId], references: [id])
  canceledBy    User?                  @relation("SaleCanceledBy", fields: [canceledById], references: [id])
  branch        Branch                 @relation(fields: [branchId], references: [id])

  @@index([branchId, date])
  @@index([status])
}

model SaleItem {
  id        Int @id @default(autoincrement())
  saleId    Int
  productId Int

  /// Cantidad vendida, en la unidad de venta del producto. `Decimal(14,3)`
  /// desde la Fase 3B: 0,425 kg de queso es una linea de ticket valida.
  quantity Decimal @db.Decimal(14, 3)

  /// Precio congelado en el momento de vender. Cambiar el precio del producto
  /// no reescribe las ventas de ayer.
  price Decimal @db.Decimal(14, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

/// Un pago de una venta. Una venta puede tener varios.
///
/// Reemplaza al `paymentMethod` unico que vivia dentro del movimiento de caja.
/// La regla que hace util la entidad: LA SUMA DE LOS PAGOS ES EXACTAMENTE EL
/// TOTAL DE LA VENTA. Con `Float` esa igualdad fallaba sola; por eso el dinero
/// se migro a Decimal antes que esto.
model SalePayment {
  id     Int @id @default(autoincrement())
  saleId Int

  /// 'CASH' | 'DEBIT_CARD' | 'CREDIT_CARD' | 'TRANSFER' | 'OTHER' | 'CARD'.
  /// Ver src/modules/sales/payment-methods.ts. `CARD` es solo historico.
  method String

  amount Decimal @db.Decimal(14, 2)

  /// Con cuanto pago y cuanto se le dio de vuelto. Solo tienen sentido en
  /// efectivo: no se puede recibir de mas en una transferencia.
  cashReceived Decimal? @db.Decimal(14, 2)
  changeGiven  Decimal? @db.Decimal(14, 2)

  /// Numero de operacion, ultimos digitos del cupon, lo que quede a mano.
  /// NUNCA el numero completo de la tarjeta ni el codigo de seguridad: en esta
  /// fase el sistema no procesa tarjetas, solo anota como se cobro.
  reference String?

  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([method])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  tableName  String
  recordId   Int?
  actionType String
  changes    Json?
  origin     String?
  timestamp  DateTime @default(now())

  /// Sucursal en la que ocurrio. Se copia del evento y no se deduce del
  /// usuario: un traslado de sucursal no debe reescribir la historia.
  branchId Int?

  /// Identificador de la peticion. Une esta fila con la linea del log del
  /// servidor y con el error que vio el usuario.
  requestId String?

  /// Direccion de origen. Hasta 45 caracteres: una IPv6 con zona.
  ip String? @db.VarChar(45)

  /// Motivo declarado por el usuario, cuando la operacion lo exige
  /// (anulacion, ajuste de stock).
  reason String?

  /// 'success' | 'failure'. Un intento rechazado tambien se audita.
  result String @default("success")

  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId, timestamp])
  @@index([tableName, actionType, timestamp])
  @@index([requestId])
}

model CashRegisterMovement {
  id       Int @id @default(autoincrement())
  branchId Int
  userId   Int

  /// Importe con signo: positivo entra, negativo sale. El signo lo decide el
  /// servidor a partir del tipo, nunca el cliente.
  amount Decimal @db.Decimal(14, 2)

  paymentMethod String
  description   String?
  date          DateTime @default(now())
  type          String

  /// Vinculo explicito con la venta. Reemplaza el parseo de "Venta #123"
  /// sobre el campo description, que era la unica forma de relacionarlos.
  saleId Int?

  /// Turno en el que ocurrio. Null solo en los movimientos anteriores a que
  /// existieran los turnos, que la migracion cuelga del turno `legacy`.
  shiftId Int?

  branch Branch     @relation(fields: [branchId], references: [id])
  user   User       @relation(fields: [userId], references: [id])
  sale   Sale?      @relation(fields: [saleId], references: [id])
  shift  CashShift? @relation(fields: [shiftId], references: [id])

  @@index([branchId, date])
  @@index([saleId])
  /// El saldo esperado de un turno suma los movimientos en efectivo de ESE
  /// turno. Es la consulta que se hace en cada venta y en cada cierre.
  @@index([shiftId, paymentMethod])
}

model CashCount {
  id       Int      @id @default(autoincrement())
  branchId Int
  userId   Int
  /// Lo que se conto fisicamente en el cajon.
  amount   Decimal  @db.Decimal(14, 2)
  date     DateTime @default(now())
  notes    String? // notas u observaciones opcionales

  /// Lo que el sistema esperaba. Lo calcula el servidor, nunca el cliente.
  expected Decimal @default(0) @db.Decimal(14, 2)

  /// contado - esperado. Positivo sobra, negativo falta.
  ///
  /// Se guarda calculado y no se deduce al leer: asi se puede preguntar por
  /// "arqueos con diferencia" sin recorrer texto. Antes los dos valores
  /// vivian dentro de `notes` como una frase.
  difference Decimal @default(0) @db.Decimal(14, 2)

  /// Turno contra el que se hizo el arqueo. Null en los arqueos anteriores a
  /// que existieran los turnos, que la migracion cuelga del turno `legacy`.
  ///
  /// Un arqueo NO cierra el turno: es un recuento intermedio. El cierre es
  /// otra operacion, con su propia confirmacion.
  shiftId Int?

  branch Branch     @relation(fields: [branchId], references: [id])
  user   User       @relation(fields: [userId], references: [id])
  shift  CashShift? @relation(fields: [shiftId], references: [id])

  @@index([branchId, date])
  @@index([shiftId])
}
