generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id            Int                    @id @default(autoincrement())
  name          String                 @unique
  address       String?
  createdAt     DateTime               @default(now())
  email         String?
  phone         String?
  products      BranchStock[]
  sales         Sale[]
  users         User[]
  cashMovements CashRegisterMovement[]
  cashCounts    CashCount[]
  productsList  Product[]
  auditLogs     AuditLog[]
  cashShifts    CashShift[]

  /// Efectivo acumulado desde que se instalo el sistema.
  ///
  /// YA NO DECIDE NADA. Desde la Fase 3 el arqueo compara contra el turno, la
  /// cabecera muestra el turno y el cierre calcula sobre el turno. Esto queda
  /// como dato historico de la sucursal --hay dos anios apoyados en el-- y se
  /// sigue actualizando, pero ningun camino lo consulta para decidir.
  /// Ver docs/CASH_SHIFT_MODEL.md.
  ///
  /// `Decimal(14,2)` desde la Fase 3: en `Float` la suma de ventas y la
  /// reversion de una anulacion no volvian al mismo numero.
  currentCash Decimal @default(0) @db.Decimal(14, 2)

  /// Si hace falta un turno abierto para poder vender.
  ///
  /// Verdadero por omision: es el punto de tener turnos. Se puede apagar por
  /// sucursal para dar salida a un local que todavia no adopto el flujo, sin
  /// que el sistema le mienta diciendo que la caja "cuadra".
  requireOpenShift Boolean @default(true)

  /// Diferencia de arqueo a partir de la cual el cierre necesita autorizacion.
  ///
  /// Cero significa sin umbral. Es un numero y una comprobacion, no un sistema
  /// de reglas: cuando haga falta algo mas se disenia entonces.
  cashDifferenceThreshold Decimal @default(0) @db.Decimal(14, 2)
}

/// Turno de caja: se abre contando el cajon y se cierra volviendolo a contar.
///
/// Reemplaza al acumulado historico como respuesta a la unica pregunta que se
/// hace en el mostrador: "empece con esto, paso esto, tengo que tener esto,
/// ¿lo tengo?". Ver docs/CASH_SHIFT_MODEL.md.
model CashShift {
  id       Int @id @default(autoincrement())
  branchId Int

  openedById Int
  closedById Int?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  /// Lo que habia en el cajon al abrir. NO se puede editar despues: un saldo
  /// inicial editable convierte cualquier faltante en un problema de tipeo.
  openingAmount Decimal @db.Decimal(14, 2)

  /// Lo que el sistema esperaba AL CERRAR. Null mientras el turno esta
  /// abierto, y a proposito: durante el turno el esperado se DERIVA de los
  /// movimientos. Guardarlo antes obligaria a mantenerlo sincronizado en cada
  /// venta, y el dia que un camino se olvide deja de significar nada --que es
  /// exactamente lo que pasaba con `Branch.currentCash`--.
  expectedAmount Decimal? @db.Decimal(14, 2)

  /// Lo que se conto fisicamente al cerrar.
  countedAmount Decimal? @db.Decimal(14, 2)

  /// contado - esperado. Positivo sobra, negativo falta.
  difference Decimal? @db.Decimal(14, 2)

  /// 'open' | 'closed' | 'legacy'.
  ///
  /// `legacy` es el turno que crea la migracion para colgarle todo lo anterior
  /// a que existieran los turnos. No se cierra, no se reabre y no cuenta como
  /// turno abierto.
  status String @default("open")

  openingNotes String?
  closingNotes String?

  /// Quien autorizo una diferencia por encima del umbral de la sucursal.
  authorizedById Int?

  branch       Branch @relation(fields: [branchId], references: [id])
  openedBy     User   @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy     User?  @relation("ShiftClosedBy", fields: [closedById], references: [id])
  authorizedBy User?  @relation("ShiftAuthorizedBy", fields: [authorizedById], references: [id])

  movements CashRegisterMovement[]
  counts    CashCount[]

  @@index([branchId, openedAt])
  @@index([branchId, status])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  password  String
  name      String
  roleId    Int
  branchId  Int
  createdAt DateTime @default(now())
  username  String   @unique

  /// Un usuario dado de baja conserva su historial pero no puede iniciar sesion.
  /// Nunca se borra: los registros financieros lo referencian.
  isActive Boolean @default(true)

  /// Se incrementa para invalidar todas las sesiones abiertas del usuario
  /// (cambio de contrasena, baja, revocacion manual). El JWT lleva el valor
  /// con el que fue emitido; si no coincide con el actual, la sesion se rechaza.
  sessionVersion Int @default(0)

  logs             AuditLog[]
  sales            Sale[]                 @relation("SaleCreatedBy")
  canceledSales    Sale[]                 @relation("SaleCanceledBy")
  stockChecks      StockCheck[]
  cashMovements    CashRegisterMovement[] // ← relación inversa agregada
  shiftsOpened     CashShift[]            @relation("ShiftOpenedBy")
  shiftsClosed     CashShift[]            @relation("ShiftClosedBy")
  shiftsAuthorized CashShift[]            @relation("ShiftAuthorizedBy")
  branch           Branch                 @relation(fields: [branchId], references: [id])
  role             Role                   @relation(fields: [roleId], references: [id])
  cashCounts       CashCount[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  barcode     String? @unique
  description String?
  supplierId  Int?
  categoryId  Int

  /// Precio de venta. Dos decimales: es lo que se cobra.
  price Decimal @db.Decimal(14, 2)

  /// Sin uso. Quedo de una migracion de mayo de 2025 y no se borra: quitar
  /// una columna en una migracion que corre en el servidor es exactamente lo
  /// que docs/DATABASE_MIGRATION_STRATEGY.md prohibe. Deuda anotada.
  value    Int?
  branchId Int

  /// Un producto dado de baja sale del catalogo de venta pero conserva su
  /// historial. Nunca se borra: los items de venta lo referencian, y borrarlo
  /// falsearia los reportes de meses anteriores.
  isActive Boolean @default(true)

  stocks    BranchStock[]
  saleItems SaleItem[]
  category  Category      @relation(fields: [categoryId], references: [id])
  supplier  Supplier?     @relation(fields: [supplierId], references: [id])
  branch    Branch        @relation(fields: [branchId], references: [id])

  /// La caja busca por sucursal y por estado en cada tecla.
  @@index([branchId, isActive])
}

model BranchStock {
  id        Int @id @default(autoincrement())
  branchId  Int
  productId Int
  quantity  Int

  branch  Branch       @relation(fields: [branchId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  checks  StockCheck[] // back-relation para StockCheck

  @@unique([branchId, productId])
}

model StockCheck {
  id      Int      @id @default(autoincrement())
  stockId Int
  userId  Int
  date    DateTime @default(now())

  stock BranchStock @relation(fields: [stockId], references: [id])
  user  User        @relation(fields: [userId], references: [id])

  @@unique([stockId, userId, date])
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  contact  String?
  products Product[]
}

model Sale {
  id         Int      @id @default(autoincrement())
  userId     Int
  branchId   Int
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  isVerified Boolean  @default(false)

  /// "completed" | "canceled". Una venta nunca se borra: se anula.
  status       String    @default("completed")
  canceledAt   DateTime?
  canceledById Int?
  cancelReason String?

  items         SaleItem[]
  cashMovements CashRegisterMovement[]
  user          User                   @relation("SaleCreatedBy", fields: [userId], references: [id])
  canceledBy    User?                  @relation("SaleCanceledBy", fields: [canceledById], references: [id])
  branch        Branch                 @relation(fields: [branchId], references: [id])

  @@index([branchId, date])
  @@index([status])
}

model SaleItem {
  id        Int @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int

  /// Precio congelado en el momento de vender. Cambiar el precio del producto
  /// no reescribe las ventas de ayer.
  price Decimal @db.Decimal(14, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  tableName  String
  recordId   Int?
  actionType String
  changes    Json?
  origin     String?
  timestamp  DateTime @default(now())

  /// Sucursal en la que ocurrio. Se copia del evento y no se deduce del
  /// usuario: un traslado de sucursal no debe reescribir la historia.
  branchId Int?

  /// Identificador de la peticion. Une esta fila con la linea del log del
  /// servidor y con el error que vio el usuario.
  requestId String?

  /// Direccion de origen. Hasta 45 caracteres: una IPv6 con zona.
  ip String? @db.VarChar(45)

  /// Motivo declarado por el usuario, cuando la operacion lo exige
  /// (anulacion, ajuste de stock).
  reason String?

  /// 'success' | 'failure'. Un intento rechazado tambien se audita.
  result String @default("success")

  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId, timestamp])
  @@index([tableName, actionType, timestamp])
  @@index([requestId])
}

model CashRegisterMovement {
  id       Int @id @default(autoincrement())
  branchId Int
  userId   Int

  /// Importe con signo: positivo entra, negativo sale. El signo lo decide el
  /// servidor a partir del tipo, nunca el cliente.
  amount Decimal @db.Decimal(14, 2)

  paymentMethod String
  description   String?
  date          DateTime @default(now())
  type          String

  /// Vinculo explicito con la venta. Reemplaza el parseo de "Venta #123"
  /// sobre el campo description, que era la unica forma de relacionarlos.
  saleId Int?

  /// Turno en el que ocurrio. Null solo en los movimientos anteriores a que
  /// existieran los turnos, que la migracion cuelga del turno `legacy`.
  shiftId Int?

  branch Branch     @relation(fields: [branchId], references: [id])
  user   User       @relation(fields: [userId], references: [id])
  sale   Sale?      @relation(fields: [saleId], references: [id])
  shift  CashShift? @relation(fields: [shiftId], references: [id])

  @@index([branchId, date])
  @@index([saleId])
  /// El saldo esperado de un turno suma los movimientos en efectivo de ESE
  /// turno. Es la consulta que se hace en cada venta y en cada cierre.
  @@index([shiftId, paymentMethod])
}

model CashCount {
  id       Int      @id @default(autoincrement())
  branchId Int
  userId   Int
  /// Lo que se conto fisicamente en el cajon.
  amount   Decimal  @db.Decimal(14, 2)
  date     DateTime @default(now())
  notes    String? // notas u observaciones opcionales

  /// Lo que el sistema esperaba. Lo calcula el servidor, nunca el cliente.
  expected Decimal @default(0) @db.Decimal(14, 2)

  /// contado - esperado. Positivo sobra, negativo falta.
  ///
  /// Se guarda calculado y no se deduce al leer: asi se puede preguntar por
  /// "arqueos con diferencia" sin recorrer texto. Antes los dos valores
  /// vivian dentro de `notes` como una frase.
  difference Decimal @default(0) @db.Decimal(14, 2)

  /// Turno contra el que se hizo el arqueo. Null en los arqueos anteriores a
  /// que existieran los turnos, que la migracion cuelga del turno `legacy`.
  ///
  /// Un arqueo NO cierra el turno: es un recuento intermedio. El cierre es
  /// otra operacion, con su propia confirmacion.
  shiftId Int?

  branch Branch     @relation(fields: [branchId], references: [id])
  user   User       @relation(fields: [userId], references: [id])
  shift  CashShift? @relation(fields: [shiftId], references: [id])

  @@index([branchId, date])
  @@index([shiftId])
}
