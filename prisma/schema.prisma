generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id             Int                       @id @default(autoincrement())
  name           String                    @unique
  address        String?
  createdAt      DateTime                  @default(now())
  email          String?
  phone          String?
  products       BranchStock[]
  sales          Sale[]
  users          User[]
  cashMovements  CashRegisterMovement[]
  cashCounts     CashCount[]
  productsList   Product[]
  auditLogs      AuditLog[]
  cashShifts     CashShift[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  receipts       PurchaseReceipt[]
  clients        Client[]
  accountMoves   CustomerAccountMovement[]
  clientPayments CustomerPayment[]
  supplierMoves  SupplierAccountMovement[]
  supplierPays   SupplierPayment[]
  returns        PurchaseReturn[]
  lotStocks      BranchLotStock[]
  lotAssignments LotAssignment[]
  countSessions  InventoryCountSession[]

  /// Efectivo acumulado desde que se instalo el sistema.
  ///
  /// YA NO DECIDE NADA. Desde la Fase 3 el arqueo compara contra el turno, la
  /// cabecera muestra el turno y el cierre calcula sobre el turno. Esto queda
  /// como dato historico de la sucursal --hay dos anios apoyados en el-- y se
  /// sigue actualizando, pero ningun camino lo consulta para decidir.
  /// Ver docs/CASH_SHIFT_MODEL.md.
  ///
  /// `Decimal(14,2)` desde la Fase 3: en `Float` la suma de ventas y la
  /// reversion de una anulacion no volvian al mismo numero.
  currentCash Decimal @default(0) @db.Decimal(14, 2)

  /// Si hace falta un turno abierto para poder vender.
  ///
  /// Verdadero por omision: es el punto de tener turnos. Se puede apagar por
  /// sucursal para dar salida a un local que todavia no adopto el flujo, sin
  /// que el sistema le mienta diciendo que la caja "cuadra".
  requireOpenShift Boolean @default(true)

  /// Diferencia de arqueo a partir de la cual el cierre necesita autorizacion.
  ///
  /// Cero significa sin umbral. Es un numero y una comprobacion, no un sistema
  /// de reglas: cuando haga falta algo mas se disenia entonces.
  cashDifferenceThreshold Decimal @default(0) @db.Decimal(14, 2)

  /// La zona horaria DEL LOCAL. Identificador IANA, no un desfase.
  ///
  /// Es lo que define el DIA COMERCIAL: "las ventas de hoy" son las de un dia
  /// que empieza y termina segun el reloj de este comercio, no segun el del
  /// servidor ni el del navegador.
  ///
  /// IANA y no `UTC-3` porque una zona horaria es una REGLA y no un numero:
  /// Argentina tuvo horario de verano entre 2007 y 2009, y una consulta sobre
  /// diciembre de 2008 tiene que usar el desfase que regia ENTONCES. Un numero
  /// fijo corre el dia entero una hora hacia atras en toda esa temporada.
  ///
  /// Hasta la Fase 3D esto lo decidia la zona del proceso, y antes de la 3C lo
  /// decidia UTC: toda venta posterior a las 21:00 desaparecia del dia. Ver
  /// docs/TIMEZONE_POLICY.md.
  timeZone String @default("America/Argentina/Buenos_Aires")
}

/// Turno de caja: se abre contando el cajon y se cierra volviendolo a contar.
///
/// Reemplaza al acumulado historico como respuesta a la unica pregunta que se
/// hace en el mostrador: "empece con esto, paso esto, tengo que tener esto,
/// ¿lo tengo?". Ver docs/CASH_SHIFT_MODEL.md.
model CashShift {
  id       Int @id @default(autoincrement())
  branchId Int

  openedById Int
  closedById Int?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  /// Lo que habia en el cajon al abrir. NO se puede editar despues: un saldo
  /// inicial editable convierte cualquier faltante en un problema de tipeo.
  openingAmount Decimal @db.Decimal(14, 2)

  /// Lo que el sistema esperaba AL CERRAR. Null mientras el turno esta
  /// abierto, y a proposito: durante el turno el esperado se DERIVA de los
  /// movimientos. Guardarlo antes obligaria a mantenerlo sincronizado en cada
  /// venta, y el dia que un camino se olvide deja de significar nada --que es
  /// exactamente lo que pasaba con `Branch.currentCash`--.
  expectedAmount Decimal? @db.Decimal(14, 2)

  /// Lo que se conto fisicamente al cerrar.
  countedAmount Decimal? @db.Decimal(14, 2)

  /// contado - esperado. Positivo sobra, negativo falta.
  difference Decimal? @db.Decimal(14, 2)

  /// 'open' | 'closed' | 'legacy'.
  ///
  /// `legacy` es el turno que crea la migracion para colgarle todo lo anterior
  /// a que existieran los turnos. No se cierra, no se reabre y no cuenta como
  /// turno abierto.
  status String @default("open")

  openingNotes String?
  closingNotes String?

  /// Quien autorizo una diferencia por encima del umbral de la sucursal.
  authorizedById Int?

  branch       Branch @relation(fields: [branchId], references: [id])
  openedBy     User   @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy     User?  @relation("ShiftClosedBy", fields: [closedById], references: [id])
  authorizedBy User?  @relation("ShiftAuthorizedBy", fields: [authorizedById], references: [id])

  movements      CashRegisterMovement[]
  counts         CashCount[]
  clientPayments CustomerPayment[]
  supplierPays   SupplierPayment[]

  @@index([branchId, openedAt])
  @@index([branchId, status])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  password  String
  name      String
  roleId    Int
  branchId  Int
  createdAt DateTime @default(now())
  username  String   @unique

  /// Un usuario dado de baja conserva su historial pero no puede iniciar sesion.
  /// Nunca se borra: los registros financieros lo referencian.
  isActive Boolean @default(true)

  /// Se incrementa para invalidar todas las sesiones abiertas del usuario
  /// (cambio de contrasena, baja, revocacion manual). El JWT lleva el valor
  /// con el que fue emitido; si no coincide con el actual, la sesion se rechaza.
  sessionVersion Int @default(0)

  logs             AuditLog[]
  costChanges      ProductCostHistory[]
  sales            Sale[]                      @relation("SaleCreatedBy")
  canceledSales    Sale[]                      @relation("SaleCanceledBy")
  stockChecks      StockCheck[]
  stockMovements   StockMovement[]
  ordersCreated    PurchaseOrder[]             @relation("PurchaseOrderCreatedBy")
  ordersCancelled  PurchaseOrder[]             @relation("PurchaseOrderCancelledBy")
  receipts         PurchaseReceipt[]
  cashMovements    CashRegisterMovement[] // ← relación inversa agregada
  shiftsOpened     CashShift[]                 @relation("ShiftOpenedBy")
  shiftsClosed     CashShift[]                 @relation("ShiftClosedBy")
  shiftsAuthorized CashShift[]                 @relation("ShiftAuthorizedBy")
  branch           Branch                      @relation(fields: [branchId], references: [id])
  role             Role                        @relation(fields: [roleId], references: [id])
  cashCounts       CashCount[]
  accountMoves     CustomerAccountMovement[]   @relation("AccountMovementBy")
  accountOverrides CustomerAccountMovement[]   @relation("AccountMovementAuthorizedBy")
  clientPayments   CustomerPayment[]
  supplierMoves    SupplierAccountMovement[]   @relation("SupplierMovementBy")
  supplierApproved SupplierAccountMovement[]   @relation("SupplierMovementAuthorizedBy")
  supplierPays     SupplierPayment[]
  allocations      SupplierPaymentAllocation[]
  returnsCreated   PurchaseReturn[]            @relation("PurchaseReturnCreatedBy")
  returnsConfirmed PurchaseReturn[]            @relation("PurchaseReturnConfirmedBy")
  returnsCancelled PurchaseReturn[]            @relation("PurchaseReturnCancelledBy")
  lotsCreated      ProductLot[]
  lotAssignments   LotAssignment[]
  countsStarted    InventoryCountSession[]     @relation("CountStartedBy")
  countsApplied    InventoryCountSession[]     @relation("CountAppliedBy")
  countsCancelled  InventoryCountSession[]     @relation("CountCancelledBy")
  countLines       InventoryCountLine[]
}

model Category {
  id            Int                     @id @default(autoincrement())
  name          String                  @unique
  products      Product[]
  countSessions InventoryCountSession[]
}

model Product {
  id   Int    @id @default(autoincrement())
  name String

  description String?

  categoryId Int

  /// Precio de venta, POR UNIDAD DE VENTA. Dos decimales: es lo que se cobra.
  /// Un producto con `saleUnit = KG` a `9800.00` vale $9.800 el kilo.
  price Decimal @db.Decimal(14, 2)

  /// Cuanto cuesta comprarlo. NULL significa "no sabemos".
  ///
  /// Nulo y no cero, y sobre todo no igual al precio: un margen de cero
  /// inventado se ve exactamente igual que un margen de cero real, y alguien
  /// va a tomar una decision de precios mirandolo. Todo el catalogo migrado
  /// arranca en NULL.
  ///
  /// Cuatro decimales porque el costo se DERIVA de una division: una caja de 8
  /// a $12.345 da $1.543,125 por unidad. Ver docs/PHASE3_MONEY_MIGRATION.md.
  ///
  /// Solo sale hacia la API para quien tenga `products.cost.view`. El endpoint
  /// que usa la caja NUNCA lo incluye.
  cost Decimal? @db.Decimal(14, 4)

  /// Unidad en la que se VENDE: UNIT | KG | G | L | ML.
  ///
  /// Es la unidad de `price`, de `minimumStock`, de `BranchStock.quantity`, de
  /// `SaleItem.quantity` y de todo el libro de movimientos del producto. Por
  /// eso NO SE PUEDE CAMBIAR cuando el producto ya tiene historial: hay un
  /// disparador en la base que lo impide, porque cambiarla reescribiria en
  /// silencio el significado de todo su pasado.
  saleUnit String @default("UNIT")

  /// Unidad en la que se COMPRA: las cinco de venta mas PACK y BOX.
  ///
  /// PACK y BOX existen solo de este lado. Como unidad de venta no aportan
  /// nada --un six-pack que se vende entero se vende por unidad, y la unidad es
  /// el six-pack--; como unidad de compra son el unico modo de que
  /// `unitsPerPurchaseUnit` se pueda leer.
  purchaseUnit String @default("UNIT")

  /// Cuantas unidades de venta trae una unidad de compra. Una caja de 8: `8`.
  ///
  /// Preparado para la Fase 3C, que es donde se usa de verdad. Decimal porque
  /// tambien es una cantidad: "una caja trae 12,5 kg" es tan valido como "una
  /// caja trae 8 unidades".
  unitsPerPurchaseUnit Decimal @default(1) @db.Decimal(14, 3)

  /// CONGELADA. Sin uso desde siempre: quedo de una migracion de mayo de 2025
  /// y nunca significo nada.
  ///
  /// No se borra en la Fase 3D junto con las otras dos porque no hay ningun
  /// motivo para hacerlo: no confunde a nadie, no aparece en ninguna pantalla
  /// y no sostiene ninguna relacion. Borrar una columna tiene un costo --una
  /// migracion destructiva mas que revisar-- y esta no paga ninguno.
  value    Int?
  branchId Int

  /// Un producto dado de baja sale del catalogo de venta pero conserva su
  /// historial. Nunca se borra: los items de venta lo referencian, y borrarlo
  /// falsearia los reportes de meses anteriores.
  isActive Boolean @default(true)

  /// Cantidad por debajo de la cual hay que reponer, EN LA UNIDAD DE VENTA.
  ///
  /// Cero significa SIN MINIMO CONFIGURADO, y con cero el estado `LOW` no se
  /// cumple nunca: `quantity > 0 && quantity <= 0` es imposible. Es el valor
  /// que la migracion le pone a todo el catalogo existente, a proposito: el
  /// sistema no sabe cuantos fideos quiere tener este almacen y no lo inventa.
  ///
  /// `Decimal(14,3)` desde la Fase 3B: el minimo de un producto por peso son
  /// 3,5 kg, no 3 ni 4. Tiene que estar en el mismo tipo y en la misma unidad
  /// que el stock, que es la unica forma de que `stock <= minimo` signifique
  /// algo.
  ///
  /// El estado (OK / LOW / OUT) NO se guarda: se calcula al leer. Ver
  /// docs/INVENTORY_LEDGER.md.
  minimumStock Decimal @default(0) @db.Decimal(14, 3)

  /// Si este producto se sigue por lote: NONE | OPTIONAL | REQUIRED.
  ///
  /// TODO EL CATALOGO EXISTENTE ARRANCA EN `NONE`, y con `NONE` el producto se
  /// comporta exactamente igual que antes de la Fase 4D: ni una consulta mas, ni
  /// una columna distinta, ni un lote vacio. Obligar a lotes a todo el catalogo
  /// convertiria la venta de una esponja en un tramite.
  ///
  ///   NONE      no se rastrea. No se le pueden crear lotes.
  ///   OPTIONAL  puede tener lotes y puede tener stock sin asignar a ninguno.
  ///   REQUIRED  todo movimiento lleva lote, y el stock sin asignar es cero.
  ///
  /// Pasar a `REQUIRED` con stock existente NO se puede hacer de un tiron: hay
  /// que decir de que lotes son esas unidades. Ver `LotAssignment` y
  /// docs/LOT_TRACKING_DESIGN.md.
  lotTracking String @default("NONE")

  /// Si se controla el vencimiento: NONE | OPTIONAL | REQUIRED.
  ///
  /// SEPARADA de `lotTracking` a proposito, y no es una bandera de mas. Una
  /// lavandina necesita numero de partida --para poder retirarla si sale mal--
  /// y no tiene vencimiento que valga la pena controlar; con una sola bandera,
  /// rastrearla obligaria a inventarle una fecha. Ver
  /// docs/LOT_EXPIRATION_POLICY.md.
  ///
  /// Al reves no: la fecha vive en el lote, asi que exigir vencimiento sin
  /// rastrear lotes no tiene donde guardarse. Lo impide un CHECK.
  expirationTracking String @default("NONE")

  stocks       BranchStock[]
  saleItems    SaleItem[]
  movements    StockMovement[]
  barcodes     ProductBarcode[]
  costHistory  ProductCostHistory[]
  suppliers    ProductSupplier[]
  orderItems   PurchaseOrderItem[]
  receiptItems PurchaseReceiptItem[]
  returnItems  PurchaseReturnItem[]
  lots         ProductLot[]
  assignments  LotAssignment[]
  countLines   InventoryCountLine[]
  category     Category              @relation(fields: [categoryId], references: [id])
  branch       Branch                @relation(fields: [branchId], references: [id])

  /// La caja busca por sucursal y por estado en cada tecla.
  @@index([branchId, isActive])
  /// El listado de lotes filtra el catalogo por politica.
  @@index([branchId, lotTracking])
}

/// Una PARTIDA de un producto: su codigo, su vencimiento y su elaboracion.
///
/// El lote es la partida, no la cantidad: cuanto hay de ella en cada sucursal lo
/// dice `BranchLotStock`. Es la misma separacion que hay entre `Product` y
/// `BranchStock`, y por el mismo motivo: la misma partida fisica puede estar
/// repartida en dos depositos.
///
/// Ver docs/LOT_TRACKING_DESIGN.md.
model ProductLot {
  id        Int @id @default(autoincrement())
  productId Int

  /// El codigo tal cual lo trae el envase. Obligatorio: un lote sin codigo no
  /// sirve para lo unico que sirve un lote, que es poder decir "esta partida".
  code String

  /// El mismo codigo normalizado --mayusculas, sin espacios de mas-- y UNICO por
  /// producto. Se guarda en vez de calcularse en la consulta para que el indice
  /// unico exista de verdad: `L-001` y `l-001 ` son la misma partida, y sin esto
  /// el sistema aceptaria las dos y despues no sabria cual tiene el stock.
  codeNormalized String

  /// FECHA de vencimiento, sin hora y sin zona. `2026-09-05`, no
  /// `2026-09-05T00:00Z`.
  ///
  /// `@db.Date` y no `timestamp`, y es la decision que evita reintroducir los
  /// errores horarios de las Fases 3C, 3D y 4A: un instante de medianoche UTC
  /// formateado en Buenos Aires se lee como el DIA ANTERIOR, y un producto
  /// vencido el 5 aparecerian vencido el 4. Una fecha de vencimiento es un dato
  /// de calendario impreso en un envase, no un momento.
  ///
  /// Nula cuando el lote no vence. Ver docs/LOT_EXPIRATION_POLICY.md.
  expirationDate DateTime? @db.Date

  /// Cuando se elaboro, si el envase lo dice. Misma naturaleza que la anterior.
  manufacturedAt DateTime? @db.Date

  /// Lo que el codigo no puede decir. Opcional y libre.
  notes String?

  createdById Int
  createdAt   DateTime @default(now())

  product     Product                  @relation(fields: [productId], references: [id])
  createdBy   User                     @relation(fields: [createdById], references: [id])
  stocks      BranchLotStock[]
  movements   StockMovement[]
  assignments LotAssignment[]
  receiptLots PurchaseReceiptItemLot[]
  saleLots    SaleItemLotAllocation[]
  returnItems PurchaseReturnItem[]
  countLines  InventoryCountLine[]

  /// Un codigo, una partida, dentro del producto. Entre productos distintos el
  /// mismo codigo es normal: dos proveedores numeran sus partidas como quieren.
  @@unique([productId, codeNormalized])
  /// Composicion para las claves foraneas compuestas: es lo que impide que un
  /// movimiento apunte al lote de OTRO producto.
  @@unique([productId, id])
  @@index([productId])
  /// El tablero de vencimientos ordena por fecha sobre todo el catalogo.
  @@index([expirationDate])
}

/// Cuanto hay de un lote en una sucursal. El `BranchStock` de los lotes.
///
/// Materializado a proposito, y por el mismo motivo que `BranchStock` existe
/// desde antes de este proyecto: la alternativa --sumar el libro del lote en
/// cada venta-- es el camino caliente de la caja y crece con el HISTORIAL, no
/// con el stock. Ver la comparacion de modelos en docs/LOT_TRACKING_DESIGN.md.
///
/// Lo escribe UNICAMENTE `applyStockMovement()`, igual que `BranchStock`. Hay
/// una regla de ESLint que lo impide desde cualquier otro lado.
model BranchLotStock {
  id       Int @id @default(autoincrement())
  branchId Int
  lotId    Int

  /// EN LA UNIDAD DE VENTA del producto, con la misma escala que el inventario:
  /// `Decimal(14,3)`. 3,250 kg de queso del lote ABC son tres kilos y cuarto.
  quantity Decimal @db.Decimal(14, 3)

  branch Branch     @relation(fields: [branchId], references: [id])
  lot    ProductLot @relation(fields: [lotId], references: [id])

  @@unique([branchId, lotId])
  @@index([lotId])
}

/// Atribucion de stock existente a un lote. El SEGUNDO libro.
///
/// Existe por una operacion que no es un movimiento de stock: activar el rastreo
/// sobre un producto que ya tiene 20 unidades obliga a decir de que lotes son, y
/// eso NO CAMBIA EL STOCK --habia 20 y siguen habiendo 20--. Lo que cambia es la
/// atribucion.
///
/// Fabricar un `StockMovement` de +20 seguido de otro de -20 para representarlo
/// seria escribir en el libro de inventario dos operaciones que nunca ocurrieron,
/// y contaminaria todo reporte de movimientos por tipo.
///
/// Es un hecho propio y merece una fila propia: el 11 de agosto, Ana declaro que
/// 8 de las 20 unidades pertenecen al lote YG-260801. Con autor, fecha y motivo,
/// como todo lo demas en este sistema.
///
/// `quantity` va CON SIGNO, igual que el libro de inventario: una atribucion
/// equivocada no se edita ni se borra, se compensa con su opuesta. La fila es
/// inmutable, con disparador.
model LotAssignment {
  id        Int @id @default(autoincrement())
  branchId  Int
  productId Int
  lotId     Int

  /// Delta CON SIGNO, en la unidad de venta. Nunca cero.
  quantity Decimal @db.Decimal(14, 3)

  /// Por que se atribuyo. Obligatorio: es la unica explicacion que va a quedar.
  reason String

  userId    Int
  createdAt DateTime @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  /// Clave foranea COMPUESTA, y no es decorativa: es lo que impide
  /// estructuralmente que una atribucion apunte al lote de otro producto. Sin
  /// ella, ocho unidades de yogur podrian quedar atribuidas a una partida de
  /// lavandina y ninguna suma se quejaria.
  lot ProductLot @relation(fields: [productId, lotId], references: [productId, id])

  @@index([branchId, productId])
  @@index([lotId])
  @@index([userId])
}

/// Un inventario fisico: contar el deposito y corregir lo que no coincide.
///
/// La diferencia con el ajuste manual de la Fase 3A es que aquel es UN producto y
/// UNA persona diciendo "quedan 30"; esto es un recorrido con estados, con
/// conteo a ciegas, con la posibilidad de contar mientras el local vende, y con
/// una aplicacion que corrige TODO junto o no corrige nada.
///
/// Ver docs/PHYSICAL_INVENTORY.md y docs/INVENTORY_COUNT_CONCURRENCY.md.
model InventoryCountSession {
  id       Int    @id @default(autoincrement())
  /// `IF-00000012`, desde una secuencia. Es la etiqueta para decir "el
  /// inventario 12" en voz alta, no un contador de nada.
  number   String
  branchId Int

  /// DRAFT | COUNTING | REVIEW | APPLIED | CANCELLED.
  ///
  /// REVIEW es el estado que hace util todo lo demas: el conteo termino y
  /// TODAVIA NO TOCO EL STOCK. Sin el, contar y corregir serian el mismo acto y
  /// nadie podria mirar las diferencias antes de que existieran.
  status String @default("DRAFT")

  /// ALL | CATEGORY | SELECTION. Que se cuenta.
  ///
  /// No hay ubicaciones ni posiciones fisicas: este sistema no tiene un modelo de
  /// deposito, y fabricar uno para poder decir "pasillo 3" seria inventar datos.
  scope String @default("ALL")

  /// La categoria, cuando el alcance es CATEGORY.
  categoryId Int?

  /// Si el operario ve lo que el sistema espera mientras cuenta.
  ///
  /// VERDADERO POR OMISION, y es medio punto de todo el mecanismo: ver "el
  /// sistema espera 18" antes de contar hace que la respuesta sea 18. Un conteo
  /// influido por el numero esperado no es un conteo, es una confirmacion.
  blindCount Boolean @default(true)

  /// Diferencia absoluta a partir de la cual la linea exige un segundo conteo.
  ///
  /// Nula significa sin doble conteo. Es un numero y una comprobacion, no un
  /// motor de reglas: el mismo criterio que `Branch.cashDifferenceThreshold`.
  recountThreshold Decimal? @db.Decimal(14, 3)

  notes String?

  startedById Int
  startedAt   DateTime @default(now())

  /// Cuando paso a REVIEW: el conteo termino. Distinto de `appliedAt`, que es
  /// cuando el stock se movio. Entre los dos puede pasar un dia.
  completedAt DateTime?

  appliedById Int?
  appliedAt   DateTime?

  cancelledById Int?
  cancelledAt   DateTime?
  cancelReason  String?

  branch      Branch    @relation(fields: [branchId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  startedBy   User      @relation("CountStartedBy", fields: [startedById], references: [id])
  appliedBy   User?     @relation("CountAppliedBy", fields: [appliedById], references: [id])
  cancelledBy User?     @relation("CountCancelledBy", fields: [cancelledById], references: [id])

  lines InventoryCountLine[]

  @@unique([number])
  @@index([branchId, status, startedAt])
  @@index([startedById])
}

/// Una linea de conteo: un producto --o un producto y un lote-- de una sesion.
///
/// `lotId` nulo significa DOS cosas distintas segun el producto, y las dos son
/// correctas: en un producto sin rastreo es "el producto"; en uno con lotes es
/// "lo que no esta asignado a ninguno".
model InventoryCountLine {
  id        Int  @id @default(autoincrement())
  sessionId Int
  productId Int
  lotId     Int?

  /// PENDING | COUNTED | RECOUNT | UNRESOLVED.
  ///
  /// UNRESOLVED es el caso del objetivo 31: aparecieron tres unidades fisicas de
  /// un producto que exige lote y nadie sabe de que partida son. NO se inventa un
  /// codigo: la linea queda marcada y la sesion NO SE PUEDE APLICAR hasta que
  /// alguien diga de que lote es o acepte que no hay.
  status String @default("PENDING")

  /// Cuanto habia CUANDO EMPEZO la sesion. Informativo: sirve para leer la
  /// linea, no para calcular la diferencia.
  snapshotQuantity Decimal @db.Decimal(14, 3)

  /// Lo que se conto fisicamente. Nulo mientras nadie haya contado.
  countedQuantity Decimal? @db.Decimal(14, 3)

  /// Lo que decia el PRIMER conteo, cuando hubo un segundo.
  ///
  /// No se pisa: es evidencia. Si el primero dijo 4 y el segundo 17, esa
  /// diferencia es informacion sobre el conteo, no ruido.
  firstCountQuantity Decimal? @db.Decimal(14, 3)

  /// Cuanto esperaba el sistema EN EL MOMENTO DE CONTAR, no al empezar.
  ///
  /// Es la columna que permite contar sin cerrar el local. Si la sesion empezo
  /// con 10, se vendieron 2 y el operario conto 8, la diferencia es CERO: lo
  /// esperado cuando conto eran 8. Ver docs/INVENTORY_COUNT_CONCURRENCY.md.
  expectedAtCount Decimal? @db.Decimal(14, 3)

  /// countedQuantity - expectedAtCount. Guardada, con un CHECK que obliga a que
  /// los tres numeros concuerden, igual que en `StockMovement`.
  variance Decimal? @db.Decimal(14, 3)

  countedById Int?
  countedAt   DateTime?

  /// Lo que dijo quien conto. "Estaban en el fondo", "faltaba una caja".
  notes String?

  session   InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product   Product               @relation(fields: [productId], references: [id])
  countedBy User?                 @relation(fields: [countedById], references: [id])

  /// RESTRICT, no el `SetNull` de Prisma: si el lote desapareciera, la linea
  /// pasaria a decir "lo no asignado" en vez de "la partida ABC", que es una
  /// afirmacion distinta sobre lo que alguien conto con la mano.
  lot ProductLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  /// Una linea por (sesion, producto, lote). El caso sin lote lo cubre un indice
  /// unico PARCIAL en la migracion, porque para PostgreSQL dos NULL son
  /// distintos entre si.
  @@unique([sessionId, productId, lotId], map: "InventoryCountLine_sesion_producto_lote_key")
  @@index([sessionId, status])
  @@index([productId])
  @@index([lotId])
}

/// Codigos de barras de un producto. Uno principal y los alternativos.
///
/// Un producto puede tener varios: el mismo yogur cambia de codigo entre
/// partidas, y el proveedor a veces manda el pack con un codigo distinto al de
/// la unidad. Con un solo codigo, el lector no encuentra la mitad de la
/// mercaderia y el cajero termina buscando por nombre.
///
/// Dos reglas, las dos en la base: un codigo apunta a UN producto en todo el
/// sistema, y un producto tiene UN codigo principal (indice unico parcial).
model ProductBarcode {
  id        Int @id @default(autoincrement())
  productId Int

  /// El codigo tal cual lo devuelve el lector. Se recorta y nada mas: pasarlo
  /// a mayusculas reescribiria codigos existentes, y para un lector dos
  /// codigos que difieren en mayusculas son dos codigos distintos.
  code String

  /// El que se muestra en la ficha y en los listados. Uno solo por producto.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  /// CASCADE, a diferencia del libro y del historial de costos: un codigo de
  /// barras no es historia, es un atributo. Sin el producto no significa nada,
  /// y conservarlo impediria borrar un producto cargado por error.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([code], map: "ProductBarcode_code_key")
  @@index([productId])
}

/// Cada cambio de costo de un producto. Inmutable.
///
/// Mismo criterio que `StockMovement`: hay un disparador en la base que impide
/// editar y borrar. Un historial de costos editable no sirve para explicar por
/// que subio un precio.
///
/// El ALTA de un producto con costo NO escribe fila aca. Un historial registra
/// CAMBIOS --por eso tiene `previousCost`, que en un alta no habria que
/// poner--, y el costo con el que nace un producto ya queda en la bitacora de
/// su creacion.
model ProductCostHistory {
  id        Int @id @default(autoincrement())
  productId Int

  /// NULL cuando el producto no tenia costo cargado, que es de donde parte
  /// todo el catalogo migrado.
  previousCost Decimal? @db.Decimal(14, 4)

  /// El costo que quedo. NULL significa QUE SE BORRO EL COSTO.
  ///
  /// Nulo desde la Fase 3D. Antes era obligatorio y borrar el costo guardaba
  /// `0`, que es una afirmacion distinta y falsa: cero es "no me costo nada"
  /// --margen del 100%-- y nulo es "no sabemos". La fila decia que el producto
  /// habia pasado a costar cero cuando lo que habia pasado era que alguien lo
  /// habia dejado sin cargar, y ademas rompia la invariante que comprueba la
  /// reconciliacion: `Product.cost` quedaba NULL y el historial decia 0.
  newCost Decimal? @db.Decimal(14, 4)

  /// De donde vino el cambio, cuando vino de una compra.
  ///
  /// `receiptId` apunta a la RECEPCION y no a la orden, y la diferencia es
  /// semantica: el costo cambia cuando la mercaderia LLEGA, no cuando se pide.
  /// Una orden confirmada a $1.025 que nunca llega no movio nada. Ademas, una
  /// orden puede tener dos recepciones con costos distintos, y apuntar a la
  /// orden no permitiria distinguirlas.
  ///
  /// Los dos siguen siendo NULL en un cambio manual desde la ficha.
  supplierId Int?
  receiptId  Int?

  userId Int

  /// Obligatorio. Un cambio de costo sin motivo no se puede auditar despues.
  reason String

  createdAt DateTime @default(now())

  product  Product          @relation(fields: [productId], references: [id])
  supplier Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receipt  PurchaseReceipt? @relation(fields: [receiptId], references: [id])
  user     User             @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([userId])
  @@index([receiptId])
}

/// Libro de movimientos de stock. Inmutable.
///
/// El stock deja de ser un numero y pasa a ser el saldo de un libro:
///
///   para todo producto:  suma(StockMovement.quantity) == BranchStock.quantity
///
/// `BranchStock.quantity` sigue existiendo --leer un saldo tiene que costar una
/// fila, no una suma de dos anios-- pero ya no es la fuente de la verdad: es el
/// saldo materializado de esta tabla.
///
/// Ninguna fila se edita ni se borra. Hay un disparador en la base que lo
/// impide, no solo una convencion. Los errores se corrigen con otro movimiento.
/// Ver docs/INVENTORY_LEDGER.md.
model StockMovement {
  id        Int @id @default(autoincrement())
  branchId  Int
  productId Int

  /// De que LOTE salieron o entraron estas unidades. Fase 4D.
  ///
  /// Nulo en todo el historial anterior y en todo producto con
  /// `lotTracking = NONE`, que es como arranca el catalogo entero. NO se rellena
  /// hacia atras: nadie sabe de que partida eran las unidades que se vendieron el
  /// año pasado, y un lote inventado se ve igual que uno real.
  ///
  /// Para un producto `REQUIRED` es obligatorio, y esa regla NO la puede hacer
  /// cumplir un CHECK --vive en `Product.lotTracking`, en otra tabla--: la impone
  /// `applyStockMovement()` y la comprueba la reconciliacion.
  ///
  /// La suma de los movimientos de un lote, mas sus atribuciones, es
  /// `BranchLotStock.quantity`. Ver docs/LOT_TRACKING_DESIGN.md.
  lotId Int?

  /// INITIAL | SALE | SALE_CANCEL | MANUAL_ADJUSTMENT | LOSS | BREAKAGE |
  /// INTERNAL_USE | PURCHASE_RECEIPT | PURCHASE_RETURN | INVENTORY_COUNT.
  ///
  /// La base comprueba el tipo Y el signo que le corresponde: una venta que
  /// aumente el stock no es un error que haya que buscar, es una fila que
  /// PostgreSQL rechaza.
  type String

  /// Delta CON SIGNO. Una venta de 2 escribe -2; su anulacion, +2.
  ///
  /// Firmado y no absoluto para que `SUM(quantity)` sea la reconstruccion del
  /// stock sin que la consulta tenga que conocer la tabla de signos.
  ///
  /// `Decimal(14,3)` desde la Fase 3B. En `Float` la restriccion de abajo
  /// --que los tres numeros concuerden-- fallaria sola: `0.1 + 0.2` no da
  /// `0.3` en binario, y un ajuste de 100 g sobre 200 g seria una fila que
  /// PostgreSQL rechaza. Ver docs/PHASE3_QUANTITY_MIGRATION.md.
  quantity Decimal @db.Decimal(14, 3)

  /// Saldo antes y despues, en la unidad de venta del producto. Redundantes
  /// --el tercero se deduce de los otros dos-- y guardados igual: asi una fila
  /// del historial se lee sin recorrer las anteriores. La base obliga a que los
  /// tres numeros concuerden.
  previousQuantity  Decimal @db.Decimal(14, 3)
  resultingQuantity Decimal @db.Decimal(14, 3)

  /// De donde vino: 'Sale' + id de la venta, 'BranchStock' + id del ajuste,
  /// 'PurchaseReceipt' + id de la recepcion, 'PurchaseReturn' + id de la
  /// devolucion. No es clave foranea --apunta a tablas distintas segun el
  /// tipo-- y por eso solo la escribe el servidor.
  ///
  /// Una entrada de mercaderia apunta a la RECEPCION y no a la orden: una
  /// orden puede tener varias entregas, y con la orden como referencia no se
  /// sabria cual de ellas movio estas unidades.
  referenceType String?
  referenceId   Int?

  /// Quien lo provoco. Siempre de la sesion verificada.
  userId Int

  /// Motivo declarado. Obligatorio en los ajustes; nulo en ventas y
  /// anulaciones, donde el motivo vive en la venta.
  reason String?

  createdAt DateTime @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  /// Clave foranea COMPUESTA. Es lo que impide estructuralmente que un
  /// movimiento de yogur descuente de una partida de lavandina: PostgreSQL
  /// comprueba el par (producto, lote), no el lote suelto.
  ///
  /// Con `lotId` nulo la restriccion se satisface sola --MATCH SIMPLE-- que es
  /// exactamente lo que hace falta para el historial anterior y para los
  /// productos sin rastreo.
  lot ProductLot? @relation(fields: [productId, lotId], references: [productId, id])

  /// El historial de la sucursal, que es lo que abre la pantalla.
  @@index([branchId, createdAt])
  /// El libro de UN lote, que es lo que reconstruye su saldo.
  @@index([lotId, createdAt])
  /// La ficha de un producto.
  @@index([productId, createdAt])
  /// Filtrar por tipo dentro de una sucursal.
  @@index([branchId, type, createdAt])
  /// "Que movio la venta #4832".
  @@index([referenceType, referenceId])
  /// Filtrar por quien.
  @@index([userId])
}

model BranchStock {
  id        Int @id @default(autoincrement())
  branchId  Int
  productId Int

  /// Saldo materializado del libro, EN LA UNIDAD DE VENTA del producto.
  ///
  /// `Decimal(14,3)` desde la Fase 3B: 3,500 en un producto por kilo son tres
  /// kilos y medio. La unidad NO esta aca sino en `Product.saleUnit`, y por eso
  /// esa columna no se puede cambiar una vez que el producto tiene historial:
  /// cambiarla reescribiria el significado de todo su pasado en silencio.
  quantity Decimal @db.Decimal(14, 3)

  branch  Branch       @relation(fields: [branchId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  checks  StockCheck[] // back-relation para StockCheck

  @@unique([branchId, productId])
}

model StockCheck {
  id      Int      @id @default(autoincrement())
  stockId Int
  userId  Int
  date    DateTime @default(now())

  stock BranchStock @relation(fields: [stockId], references: [id])
  user  User        @relation(fields: [userId], references: [id])

  @@unique([stockId, userId, date])
}

/// Quien nos vende la mercaderia.
///
/// Lo UNICO obligatorio es el nombre. Un almacen de barrio muchas veces conoce
/// "Distribuidora Pepe" y un telefono, y eso tiene que ser un proveedor
/// valido: exigir CUIT, correo o direccion obligaria a inventarlos, y un CUIT
/// inventado es peor que ningun CUIT porque parece un dato.
///
/// Ver docs/SUPPLIER_MODEL.md.
model Supplier {
  id Int @id @default(autoincrement())

  /// Como se lo nombra. Unico en todo el sistema: los proveedores no son de
  /// una sucursal, son del negocio.
  name String @unique

  /// Razon social, cuando difiere del nombre de fantasia.
  legalName String?

  /// Identificacion fiscal. En Argentina, el CUIT.
  ///
  /// NO se llama `cuit` a proposito: el modelo no se ata a un pais. Sirve para
  /// un CUIT, un RUT o un NIF sin obligar a migrar. La pantalla si dice
  /// "CUIT", que es como se llama para quien la usa.
  ///
  /// No se valida el digito verificador: este sistema todavia no emite nada
  /// fiscal, y rechazar datos que no se usan para nada solo estorba.
  taxId String?

  phone       String?
  /// Validado SI viene. Vacio es una respuesta valida.
  email       String?
  address     String?
  contactName String?
  notes       String?

  /// Un proveedor con actividad NO se borra: se desactiva. Uno desactivado no
  /// se puede elegir para una compra nueva, pero sigue nombrado en las viejas.
  isActive Boolean @default(true)

  /// Plazo de pago habitual, en dias. Fase 4B.
  ///
  /// SUGIERE el vencimiento al recibir: 30 dias sobre una entrega del 10/08 da
  /// el 09/09. Nada mas que eso. El vencimiento se CONGELA en la recepcion, asi
  /// que bajarlo despues a 15 dias no adelanta ninguna deuda vieja --que es
  /// exactamente lo que pide el objetivo 19-- y subirlo tampoco las prorroga.
  ///
  /// NULL y 0 vuelven a ser afirmaciones distintas, igual que en el limite de
  /// credito del cliente:
  ///
  ///   NULL  nadie declaro el plazo. No se sugiere vencimiento.
  ///   0     se le paga contra entrega. Vence el mismo dia.
  ///
  /// Ver docs/ACCOUNTS_PAYABLE_POLICY.md.
  defaultPaymentTermDays Int?

  /// Saldo materializado del libro. POSITIVO = LE DEBEMOS.
  ///
  /// El espejo exacto de `Client.balance`, con la misma relacion con su libro:
  ///
  ///   para todo proveedor:  suma(SupplierAccountMovement.amount) == balance
  ///
  /// Se guarda para que leer un saldo cueste una fila y no la suma de dos anios,
  /// pero NO es la fuente de la verdad. Y no se edita: lo escribe unicamente
  /// `applySupplierAccountMovement`. Ver docs/SUPPLIER_ACCOUNT_LEDGER.md.
  ///
  /// A diferencia del cliente, el proveedor NO es de una sucursal: el saldo es
  /// del negocio. Se le compra desde donde haga falta y se le debe una sola vez.
  balance Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costChanges ProductCostHistory[]
  catalogo    ProductSupplier[]
  orders      PurchaseOrder[]
  movements   SupplierAccountMovement[]
  payments    SupplierPayment[]
  returns     PurchaseReturn[]

  /// El listado filtra por activo y ordena por nombre.
  @@index([isActive, name])
  /// "A quienes les debemos" y "quienes tienen credito nuestro", que son dos
  /// filtros de la pantalla y del reporte de cuentas por pagar.
  @@index([balance])
}

/// Que proveedores venden este producto, y a cual se le compra normalmente.
///
/// Reemplaza a `Product.supplierId`, que ataba un producto a un unico
/// proveedor para siempre. La misma gaseosa se le compra a quien la tenga esa
/// semana, y el sistema tiene que poder decirlo.
///
/// Dos reglas, las dos en la base: un proveedor aparece una vez por producto
/// (unico compuesto) y un producto tiene UN proveedor principal (indice unico
/// parcial sobre `isPreferred`, el mismo mecanismo que el codigo de barras
/// principal).
model ProductSupplier {
  id         Int @id @default(autoincrement())
  productId  Int
  supplierId Int

  /// El codigo con el que EL PROVEEDOR llama a este producto, que casi nunca
  /// es el nuestro. Es lo que figura en su remito, y sin el cotejar una
  /// factura es trabajo manual.
  supplierCode String?

  /// Ultimo costo pactado con ESTE proveedor, por UNIDAD DE COMPRA.
  ///
  /// No es historial: es un dato de referencia para armar la proxima orden, y
  /// por eso se pisa en cada recepcion. El historial completo, inmutable y con
  /// su recepcion asociada, vive en `ProductCostHistory`.
  lastCost Decimal? @db.Decimal(14, 4)

  /// El proveedor principal. Uno solo por producto.
  isPreferred Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// CASCADE, igual que el codigo de barras: el vinculo es un atributo del
  /// producto, no historia. Sin el producto no significa nada.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// RESTRICT: un proveedor con productos asociados no se borra, se desactiva.
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@index([supplierId])
}

/// Orden de compra: lo que se le PIDIO a un proveedor.
///
/// Lo que efectivamente llego vive en `PurchaseReceipt`, y son dos cosas
/// distintas a proposito: el proveedor manda 3 cajas el lunes y 2 el miercoles,
/// o manda 4 y avisa que el resto no lo consigue. Con las recepciones adentro
/// de la orden, el sistema podria decir cuanto llego pero no cuando llego cada
/// parte, ni a que precio, ni quien la recibio.
///
/// Ver docs/PURCHASE_FLOW.md.
model PurchaseOrder {
  id Int @id @default(autoincrement())

  /// "OC-00000042". Lo genera el SERVIDOR con una secuencia de PostgreSQL.
  ///
  /// No con `count() + 1`: dos altas simultaneas leerian el mismo numero y el
  /// indice unico rechazaria a una de las dos. `nextval()` es atomico y no
  /// bloquea. Deja huecos --una orden descartada se lleva su numero-- y esta
  /// bien: es una etiqueta para decir "la 42" por telefono, no un contador.
  number String @unique

  branchId   Int
  supplierId Int

  /// DRAFT | ORDERED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED.
  ///
  /// Lo decide el SERVIDOR, siempre. Despues de cada recepcion se recalcula
  /// comparando pedido contra recibido linea por linea; el navegador no lo
  /// manda nunca. La base comprueba el valor con un CHECK.
  status String @default("DRAFT")

  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Cuando se confirmo. Null mientras es borrador: un borrador no se pidio.
  orderedAt DateTime?

  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?

  notes String?

  /// Suma de los subtotales de las lineas. LO CALCULA EL SERVIDOR.
  ///
  /// No se acepta del cliente, igual que el total de una venta desde la Fase 0
  /// y por el mismo motivo: lo que llega por la red lo escribe cualquiera.
  expectedTotal Decimal @default(0) @db.Decimal(14, 2)

  branch      Branch   @relation(fields: [branchId], references: [id])
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  createdBy   User     @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?    @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id])

  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]

  /// El listado: por sucursal, filtrando por estado, mas reciente primero.
  @@index([branchId, status, createdAt])
  /// "Que le compramos a este proveedor".
  @@index([supplierId, createdAt])
  @@index([createdById])
}

model PurchaseOrderItem {
  id              Int @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int

  /// EN UNIDAD DE COMPRA. "5 cajas" son `5.000` con `purchaseUnit = BOX`.
  orderedQuantity Decimal @db.Decimal(14, 3)

  /// Cuanto se recibio ya, en la misma unidad. La base impide que supere lo
  /// pedido con un CHECK, y el servicio suma con un UPDATE condicional para
  /// que dos recepciones simultaneas no puedan pasarse entre las dos.
  receivedQuantity Decimal @default(0) @db.Decimal(14, 3)

  /// CONGELADAS al crear la linea, copiadas del producto.
  ///
  /// No se leen de `Product` al recibir, y esa es la unica forma de que la
  /// conversion sea la pactada: si alguien cambia el producto de "caja de 8" a
  /// "caja de 12" entre el pedido y la entrega, las 5 cajas que se pidieron
  /// siguen siendo 40 unidades. Mismo principio que `SaleItem.price`.
  purchaseUnit         String
  unitsPerPurchaseUnit Decimal @db.Decimal(14, 3)

  /// Costo por UNIDAD DE COMPRA. Una caja de 8 a $8.800 guarda `8800`.
  ///
  /// El costo que llega al producto es este dividido por
  /// `unitsPerPurchaseUnit`. Guardar $8.800 como costo unitario del producto
  /// daria un margen negativo del 700 % en una botella de $1.500.
  unitCost Decimal @db.Decimal(14, 4)

  /// orderedQuantity x unitCost. Lo calcula el servidor.
  subtotal Decimal @db.Decimal(14, 2)

  order   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  items PurchaseReceiptItem[]

  /// Un producto no puede estar dos veces en la misma orden: serian dos
  /// pendientes del mismo articulo y no habria forma de saber contra cual
  /// imputar lo que llega.
  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

/// Una entrega. Lo que efectivamente LLEGO, cuando y a que precio.
///
/// INMUTABLE, con disparador en la base. Movio stock y cambio un costo;
/// editarla dejaria el libro de inventario contando una historia y la
/// recepcion contando otra. Un error se corrige con un movimiento nuevo.
///
/// Ver docs/PURCHASE_RECEIVING.md.
model PurchaseReceipt {
  id              Int @id @default(autoincrement())
  purchaseOrderId Int
  branchId        Int

  receivedById Int
  receivedAt   DateTime @default(now())

  notes String?

  /// Lo que ESTA entrega nos costo, al costo REAL de la factura. Fase 4B.
  ///
  /// Suma de `receivedQuantity x unitCost` de sus lineas, calculada por el
  /// servidor. Es el importe de la OBLIGACION: si la orden esperaba $100.000 y
  /// la factura vino $104.500, aca dice 104.500 y eso es lo que se le debe al
  /// proveedor. La diferencia contra lo esperado no desaparece --sigue linea
  /// por linea en `expectedUnitCost`, y el reporte la muestra-- pero no es
  /// deuda: deuda es lo que hay que pagar.
  ///
  /// Se guarda en vez de derivarse en cada lectura porque es el "importe
  /// original" de la tabla de deudas abiertas, y esa tabla se ordena y se
  /// filtra por el. `@default(0)` para que la migracion no tenga que inventar
  /// un valor: las recepciones anteriores a esta fase se recalculan una vez,
  /// desde sus propias lineas, en la migracion.
  total Decimal @default(0) @db.Decimal(14, 2)

  /// Cuando vence la obligacion. NULL = sin fecha registrada. Fase 4B.
  ///
  /// CONGELADO: se calcula al recibir, sumandole `defaultPaymentTermDays` del
  /// proveedor al dia comercial de la entrega, o se declara a mano. Despues no
  /// lo mueve ningun cambio en la ficha del proveedor.
  ///
  /// NULL no significa "vence hoy" ni "no vence": significa que nadie lo cargo.
  /// Una deuda sin vencimiento no aparece nunca como vencida, y aparece ultima
  /// en la imputacion automatica. Inventarle un plazo seria inventar una fecha
  /// de reclamo. Esto NO es el vencimiento del producto, que es otra fase.
  dueDate DateTime?

  /// Si esta entrega entro al libro del proveedor. Fase 4B.
  ///
  /// Existe para responder una pregunta que sin ella no tiene respuesta: "esta
  /// recepcion sin cargo, ¿es anterior al modulo o es un error?". Las dos cosas
  /// se ven igual --una fila sin ninguna de `SupplierAccountMovement`-- y son
  /// opuestas: la primera es correcta (en produccion no se genera deuda
  /// historica) y la segunda es alguien escribiendo una recepcion por fuera del
  /// servicio.
  ///
  /// Con esto, la invariante queda EXACTA y en las DOS direcciones:
  ///
  ///   debtRecorded = true  <=>  existe exactamente un PURCHASE_CHARGE suyo
  ///
  /// Es dato redundante --se deduce de la otra tabla-- y por eso mismo la
  /// reconciliacion lo comprueba en los dos sentidos: un booleano que se cree
  /// sin que nadie lo controle es peor que no tenerlo.
  ///
  /// Lo pone en `true` el servicio, en la misma transaccion en la que escribe
  /// el cargo, y nunca antes.
  debtRecorded Boolean @default(false)

  order      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  branch     Branch        @relation(fields: [branchId], references: [id])
  receivedBy User          @relation(fields: [receivedById], references: [id])

  items       PurchaseReceiptItem[]
  costChanges ProductCostHistory[]
  movements   SupplierAccountMovement[]
  allocations SupplierPaymentAllocation[]
  returns     PurchaseReturn[]

  /// Las recepciones de una orden, en orden. Es lo que muestra el detalle.
  @@index([purchaseOrderId, receivedAt])
  @@index([branchId, receivedAt])
  @@index([receivedById])
  /// Las deudas abiertas, ordenadas por vencimiento. Es la consulta de la
  /// imputacion automatica y la de la tabla de deudas.
  @@index([dueDate])
}

model PurchaseReceiptItem {
  id                  Int @id @default(autoincrement())
  purchaseReceiptId   Int
  purchaseOrderItemId Int
  productId           Int

  /// EN UNIDAD DE COMPRA. "3 cajas".
  receivedQuantity Decimal @db.Decimal(14, 3)

  /// Copiadas de la linea de la orden, que a su vez las congelo del producto.
  purchaseUnit         String
  unitsPerPurchaseUnit Decimal @db.Decimal(14, 3)

  /// Costo por unidad de compra segun LA FACTURA. Puede diferir del pedido.
  unitCost Decimal @db.Decimal(14, 4)

  /// Costo por unidad de compra segun LA ORDEN.
  ///
  /// Se guarda aunque sea redundante --esta en la linea de la orden-- porque
  /// la orden puede tener dos recepciones con costos distintos, y sin esto no
  /// se podria decir cual de las dos vino con diferencia.
  expectedUnitCost Decimal @db.Decimal(14, 4)

  /// EN UNIDAD DE VENTA: receivedQuantity x unitsPerPurchaseUnit.
  /// 3 cajas de 8 son `24.000` unidades. Es lo que entra al stock.
  stockQuantity Decimal @db.Decimal(14, 3)

  /// unitCost / unitsPerPurchaseUnit. Es lo que queda en `Product.cost`.
  ///
  /// Se guarda en vez de derivarse al leer porque derivarlo obligaria a
  /// conocer el `unitsPerPurchaseUnit` del dia de la recepcion.
  stockUnitCost Decimal @db.Decimal(14, 4)

  receipt   PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id])
  orderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product   Product           @relation(fields: [productId], references: [id])

  returnItems PurchaseReturnItem[]
  lots        PurchaseReceiptItemLot[]

  @@index([purchaseReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
}

/// Como se reparte UNA linea de recepcion entre lotes. Fase 4D.
///
/// Un pedido de 10 cajas puede llegar en dos partidas --6 que vencen el 5 de
/// septiembre y 4 el 18--, y eso es una sola linea de recepcion con dos filas
/// aca. La linea sigue diciendo cuanto llego y a que costo; esto dice de que
/// partidas era.
///
/// Es una entidad y no una columna en la linea justamente porque el reparto es
/// uno-a-muchos. Con una columna `lotId` en la linea habria que partir la
/// recepcion en dos lineas del mismo producto, y entonces el costo, la
/// conversion y el tope de lo pedido tendrian que repartirse tambien.
model PurchaseReceiptItemLot {
  id                    Int @id @default(autoincrement())
  purchaseReceiptItemId Int
  lotId                 Int

  /// EN UNIDAD DE COMPRA, igual que la linea. "6 cajas".
  quantity Decimal @db.Decimal(14, 3)

  /// EN UNIDAD DE VENTA: quantity x unitsPerPurchaseUnit de la linea.
  /// Es lo que entra al stock del lote, y se guarda por lo mismo que en la
  /// linea: el movimiento tiene que explicarse desde esta fila sin rehacer la
  /// conversion con un factor que quiza cambio.
  stockQuantity Decimal @db.Decimal(14, 3)

  receiptItem PurchaseReceiptItem @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: Cascade)
  lot         ProductLot          @relation(fields: [lotId], references: [id])

  /// Un lote una sola vez por linea. Dos filas del mismo lote habria que
  /// sumarlas para leer una sola.
  @@unique([purchaseReceiptItemId, lotId])
  @@index([lotId])
}

/// Un cliente del almacen.
///
/// Lo UNICO obligatorio es el nombre, igual que en `Supplier` y por el mismo
/// motivo: "Juan Perez" tiene que ser un cliente valido. Exigir DNI, CUIT o
/// telefono obligaria a inventarlos, y un documento inventado es peor que
/// ninguno porque parece un dato.
///
/// El cliente es DE UNA SUCURSAL. La cuenta corriente es una relacion de
/// confianza entre un comercio y una persona, y dos locales del mismo duenio
/// no necesariamente le fian a la misma gente. El dia que haga falta un cliente
/// compartido, se agrega; empezar compartiendo obligaria a separar despues.
///
/// Ver docs/CUSTOMER_MODEL.md.
model Client {
  id       Int @id @default(autoincrement())
  branchId Int

  /// Como se lo nombra. Lo unico obligatorio.
  name String

  /// DNI, o lo que el comercio use para identificarlo. Sin validar: este
  /// sistema todavia no emite nada fiscal, y rechazar datos que no se usan
  /// para nada solo estorba.
  document String?

  /// Identificacion fiscal (en Argentina, el CUIT). Mismo criterio que en
  /// `Supplier`: no se llama `cuit` para no atar el modelo a un pais.
  taxId String?

  phone   String?
  /// Validado SI viene. Vacio es una respuesta valida.
  email   String?
  address String?
  notes   String?

  /// Un cliente dado de baja conserva su historial pero no se puede elegir en
  /// una venta nueva. Nunca se borra: sus movimientos lo referencian.
  isActive Boolean @default(true)

  /// Cuanto se le permite deber, en pesos.
  ///
  /// NULL y 0 son AFIRMACIONES DISTINTAS, y confundirlas es el error que este
  /// campo existe para no cometer:
  ///
  ///   NULL  sin limite configurado. Nadie decidio cuanto se le fia.
  ///   0     no se le fia. Alguien decidio que su limite es cero.
  ///
  /// Por eso es nulo y no `@default(0)`: con cero por omision, todo cliente
  /// nuevo nacería con el fiado prohibido sin que nadie lo hubiera dispuesto.
  creditLimit Decimal? @db.Decimal(14, 2)

  /// Si se le puede fiar HOY. Distinto de `isActive`, y a proposito.
  ///
  /// Un cliente que se atraso puede seguir comprando de contado: darlo de baja
  /// para cortarle el fiado lo sacaria del sistema entero. Son dos preguntas
  /// distintas y tienen dos columnas distintas.
  isCreditEnabled Boolean @default(true)

  /// Saldo materializado del libro. POSITIVO = DEBE.
  ///
  /// Misma relacion que `BranchStock.quantity` con `StockMovement`: se guarda
  /// para que leer un saldo cueste una fila y no una suma de dos anios, pero
  /// NO es la fuente de la verdad. La fuente es el libro:
  ///
  ///   para todo cliente:  suma(CustomerAccountMovement.amount) == balance
  ///
  /// Y no se edita: lo escribe unicamente `applyAccountMovement`, que ademas
  /// es donde se comprueba el limite de credito. Ver
  /// docs/CUSTOMER_ACCOUNT_LEDGER.md.
  balance Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch                    @relation(fields: [branchId], references: [id])
  sales     Sale[]
  movements CustomerAccountMovement[]
  payments  CustomerPayment[]

  /// El listado filtra por sucursal y estado, y ordena por nombre.
  @@index([branchId, isActive, name])
  /// "Los que deben" y "los que tienen saldo a favor", que son dos filtros de
  /// la pantalla y el reporte de cuentas por cobrar.
  @@index([branchId, balance])
  /// Buscar por telefono o documento, que es como se lo encuentra en el
  /// mostrador cuando el nombre esta escrito distinto.
  @@index([branchId, phone])
  @@index([branchId, document])
}

/// Libro de cuenta corriente. Inmutable.
///
/// Mismo diseno que `StockMovement`, y por el mismo motivo: un saldo editable
/// no se puede auditar. El saldo del cliente deja de ser un numero y pasa a ser
/// el resultado de un libro:
///
///   para todo cliente:  suma(amount) == Client.balance
///
/// SIGNOS. Positivo aumenta la deuda, negativo la reduce:
///
///   SALE_CHARGE        +20.000   se le fio
///   PAYMENT             -8.000   pago
///   SALE_CANCEL        -20.000   se anulo la venta que se le habia fiado
///   MANUAL_ADJUSTMENT   +/-      correccion administrativa, con motivo
///
/// Un saldo NEGATIVO es plata a favor del cliente. No es un error: pasa cuando
/// paga de mas, y sobre todo cuando se anula una venta que ya habia pagado.
///
/// Ninguna fila se edita ni se borra: hay un disparador en la base que lo
/// impide. Un error se corrige con otro movimiento. Ver
/// docs/CUSTOMER_ACCOUNT_LEDGER.md.
model CustomerAccountMovement {
  id       Int @id @default(autoincrement())
  branchId Int
  clientId Int

  /// SALE_CHARGE | PAYMENT | SALE_CANCEL | MANUAL_ADJUSTMENT.
  ///
  /// La base comprueba el tipo Y el signo que le corresponde, igual que en el
  /// libro de stock: un pago que aumente la deuda no es un error que haya que
  /// buscar, es una fila que PostgreSQL rechaza.
  type String

  /// Delta CON SIGNO, en pesos.
  amount Decimal @db.Decimal(14, 2)

  /// Saldo antes y despues. Redundantes --el tercero se deduce de los otros
  /// dos-- y guardados igual: asi una fila del extracto se lee sin recorrer las
  /// anteriores, que es exactamente lo que hace falta para mostrarle a alguien
  /// por que debe lo que debe. La base obliga a que los tres concuerden.
  previousBalance  Decimal @db.Decimal(14, 2)
  resultingBalance Decimal @db.Decimal(14, 2)

  /// De donde vino. Claves foraneas de verdad --a diferencia de la referencia
  /// del libro de stock, que apunta a tablas distintas segun el tipo-- porque
  /// aca solo hay dos origenes posibles y los dos son tablas concretas.
  saleId    Int?
  paymentId Int?

  userId Int

  /// Obligatorio en los ajustes manuales. Un ajuste sin motivo no se puede
  /// auditar despues.
  reason String?

  /// Quien autorizo pasarse del limite, cuando hizo falta.
  ///
  /// Guardarlo en la fila del libro y no solo en la bitacora es deliberado: la
  /// autorizacion es parte del hecho financiero. Quien lee el extracto tiene
  /// que poder ver que esa deuda se tomo por encima del limite y quien lo
  /// permitio, sin cruzar dos tablas.
  authorizedById Int?

  createdAt DateTime @default(now())

  branch       Branch           @relation(fields: [branchId], references: [id])
  client       Client           @relation(fields: [clientId], references: [id])
  user         User             @relation("AccountMovementBy", fields: [userId], references: [id])
  authorizedBy User?            @relation("AccountMovementAuthorizedBy", fields: [authorizedById], references: [id])
  sale         Sale?            @relation(fields: [saleId], references: [id])
  payment      CustomerPayment? @relation(fields: [paymentId], references: [id])

  /// El extracto del cliente, que es lo que abre la ficha.
  @@index([clientId, createdAt])
  /// La reconciliacion y el reporte, por sucursal.
  @@index([branchId, createdAt])
  /// "Que movio la venta #482" y "que movio el recibo RC-000182".
  @@index([saleId])
  @@index([paymentId])
  @@index([userId])
}

/// Un pago que hace el cliente a cuenta de lo que debe.
///
/// Entidad propia y no solo un movimiento del libro porque un pago tiene datos
/// que el libro no tiene por que conocer: con que medio se pago, en que turno
/// entro y que numero de comprobante se le dio al cliente. El movimiento del
/// libro es la CONSECUENCIA del pago, y se crea en la misma transaccion: no
/// existe forma de registrar uno sin el otro.
///
/// Ver docs/CUSTOMER_PAYMENT_FLOW.md.
model CustomerPayment {
  id Int @id @default(autoincrement())

  /// "RC-00000182". Lo genera el SERVIDOR con una secuencia de PostgreSQL,
  /// igual que el numero de orden de compra y por el mismo motivo: `count()+1`
  /// hace que dos cobros simultaneos pidan el mismo numero.
  number String @unique

  branchId Int
  clientId Int

  /// Siempre POSITIVO: un pago de importe negativo seria un cargo disfrazado.
  /// Lo comprueba la base con un CHECK.
  amount Decimal @db.Decimal(14, 2)

  /// 'CASH' | 'DEBIT_CARD' | 'CREDIT_CARD' | 'TRANSFER' | 'OTHER'.
  ///
  /// NO admite 'ACCOUNT': pagar la cuenta con la cuenta no significa nada.
  method String

  /// Turno en el que entro, cuando entro al cajon. Null cuando no hubo turno
  /// abierto y la sucursal no lo exige.
  cashShiftId Int?

  receivedById Int

  /// Numero de operacion de la transferencia, ultimos digitos del cupon.
  reference String?
  notes     String?

  createdAt DateTime @default(now())

  branch        Branch                    @relation(fields: [branchId], references: [id])
  client        Client                    @relation(fields: [clientId], references: [id])
  shift         CashShift?                @relation(fields: [cashShiftId], references: [id])
  receivedBy    User                      @relation(fields: [receivedById], references: [id])
  movements     CustomerAccountMovement[]
  cashMovements CashRegisterMovement[]

  /// Los pagos de un cliente, en orden. Es lo que muestra la ficha.
  @@index([clientId, createdAt])
  /// El reporte de cobranza de la sucursal.
  @@index([branchId, createdAt])
  @@index([cashShiftId])
  @@index([receivedById])
}

/// Libro de cuenta con un proveedor. Inmutable. Fase 4B.
///
/// El espejo de `CustomerAccountMovement`, y a proposito: el mismo diseno, el
/// mismo vocabulario de campos y las mismas garantias, con el signo mirando
/// para el otro lado. Quien entendio uno entiende el otro.
///
///   para todo proveedor:  suma(amount) == Supplier.balance
///
/// SIGNOS. Positivo aumenta lo que LE DEBEMOS:
///
///   PURCHASE_CHARGE     +120.000   llego mercaderia y hay que pagarla
///   PAYMENT              -40.000   le pagamos
///   PURCHASE_CREDIT      -10.000   emitio una nota de credito a favor nuestro
///   MANUAL_ADJUSTMENT     +/-      correccion administrativa, con motivo
///
/// Un saldo NEGATIVO es credito NUESTRO con el proveedor: pasa cuando se le
/// paga de mas y cuando la nota de credito supera lo que quedaba debiendo.
///
/// Ninguna fila se edita ni se borra: hay un disparador en la base que lo
/// impide. Ver docs/SUPPLIER_ACCOUNT_LEDGER.md.
model SupplierAccountMovement {
  id Int @id @default(autoincrement())

  /// La sucursal DESDE LA QUE se opero.
  ///
  /// Informativa, no particionadora: a diferencia del cliente, el saldo del
  /// proveedor NO es por sucursal --se le debe una sola vez-- pero saber desde
  /// donde se recibio y desde donde se pago es lo que permite responder "que
  /// compro cada local" sin cruzar tres tablas.
  branchId   Int
  supplierId Int

  /// PURCHASE_CHARGE | PAYMENT | PURCHASE_CREDIT | MANUAL_ADJUSTMENT.
  ///
  /// La base comprueba el tipo Y el signo que le corresponde: un pago que
  /// aumente la deuda no es un error que haya que buscar, es una fila que
  /// PostgreSQL rechaza.
  type String

  /// Delta CON SIGNO, en pesos.
  amount Decimal @db.Decimal(14, 2)

  /// Saldo antes y despues. Redundantes y guardados igual, para que una fila
  /// del extracto se lea sin recorrer las anteriores. La base obliga a que los
  /// tres concuerden.
  previousBalance  Decimal @db.Decimal(14, 2)
  resultingBalance Decimal @db.Decimal(14, 2)

  /// De donde vino. Los tres origenes con un hecho detras.
  receiptId Int?
  paymentId Int?

  /// La devolucion que genero este credito. Fase 4C.
  ///
  /// Es una CLAVE FORANEA y no un texto en `reason`, que es lo que pide el
  /// objetivo 14: con el texto, "¿que credito emitio la devolucion DV-00000124?"
  /// se responde leyendo frases; con esto se responde con una union. Y la
  /// reconciliacion puede comprobar que el importe del movimiento coincida con
  /// el de la devolucion, que con un texto seria imposible.
  ///
  /// Un `PURCHASE_CREDIT` puede seguir sin devolucion --una nota de credito del
  /// proveedor por una diferencia de facturacion no devuelve mercaderia-- y por
  /// eso es opcional. Lo que NO puede es haber dos creditos de la misma
  /// devolucion: hay un indice unico parcial que lo impide.
  returnId Int?

  userId Int

  /// Obligatorio en el ajuste manual y en la nota de credito.
  ///
  /// La nota de credito lo exige y el cargo de una recepcion no, y la
  /// diferencia es real: una recepcion tiene mercaderia y un remito detras, y
  /// una nota de credito es un papel que dice que algo salio mal. Sin el motivo
  /// no queda registro de QUE salio mal.
  reason String?

  /// Numero del documento del proveedor, cuando lo hay.
  ///
  /// El de SU nota de credito. No es un numero nuestro y no se valida: es lo
  /// que permite cotejar contra el papel que mando el proveedor. Sin esto,
  /// discutir una nota de credito por telefono obliga a buscarla por importe.
  reference String?

  /// Quien autorizo el sobrepago, cuando hizo falta.
  ///
  /// Guardarlo en la fila del libro y no solo en la bitacora es deliberado, por
  /// lo mismo que en el libro del cliente: la autorizacion es parte del hecho
  /// financiero.
  authorizedById Int?

  createdAt DateTime @default(now())

  branch       Branch           @relation(fields: [branchId], references: [id])
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  user         User             @relation("SupplierMovementBy", fields: [userId], references: [id])
  authorizedBy User?            @relation("SupplierMovementAuthorizedBy", fields: [authorizedById], references: [id])
  receipt      PurchaseReceipt? @relation(fields: [receiptId], references: [id])
  payment      SupplierPayment? @relation(fields: [paymentId], references: [id])
  return       PurchaseReturn?  @relation(fields: [returnId], references: [id])

  /// El extracto del proveedor, que es lo que abre la pestania.
  @@index([supplierId, createdAt])
  /// La reconciliacion y el reporte, por sucursal.
  @@index([branchId, createdAt])
  /// "Que movio esta recepcion" y "que movio el comprobante PP-00000128".
  @@index([receiptId])
  @@index([paymentId])
  @@index([returnId])
  @@index([userId])
}

/// Un pago que le hacemos a un proveedor. Fase 4B.
///
/// Entidad propia y no solo una fila del libro por lo mismo que
/// `CustomerPayment`: un pago tiene datos que el libro no tiene por que conocer
/// --con que medio se pago, de que turno salio la plata, que numero de
/// comprobante interno lleva-- y ademas se imputa a obligaciones concretas.
///
/// Ver docs/SUPPLIER_PAYMENT_FLOW.md.
model SupplierPayment {
  id Int @id @default(autoincrement())

  /// "PP-00000128". Lo genera el SERVIDOR con una secuencia de PostgreSQL,
  /// igual que `OC-` y `RC-` y por el mismo motivo: `count()+1` hace que dos
  /// pagos simultaneos pidan el mismo numero.
  number String @unique

  branchId   Int
  supplierId Int

  /// Siempre POSITIVO: un pago de importe negativo seria un cargo disfrazado.
  /// Lo comprueba la base con un CHECK.
  amount Decimal @db.Decimal(14, 2)

  /// 'CASH' | 'TRANSFER' | 'CARD' | 'OTHER'.
  ///
  /// NO admite 'ACCOUNT': pagarle la cuenta al proveedor con su propia cuenta
  /// no significa nada. Es la misma exclusion que en el cobro al cliente.
  method String

  /// Turno del que salio la plata, cuando salio del cajon. Null cuando se pago
  /// por transferencia: esa plata no sale del cajon y no necesita turno.
  cashShiftId Int?

  paidById Int
  paidAt   DateTime @default(now())

  /// Numero de operacion de la transferencia, ultimos digitos del cupon.
  reference String?
  notes     String?

  createdAt DateTime @default(now())

  branch        Branch                      @relation(fields: [branchId], references: [id])
  supplier      Supplier                    @relation(fields: [supplierId], references: [id])
  shift         CashShift?                  @relation(fields: [cashShiftId], references: [id])
  paidBy        User                        @relation(fields: [paidById], references: [id])
  movements     SupplierAccountMovement[]
  allocations   SupplierPaymentAllocation[]
  cashMovements CashRegisterMovement[]

  /// Los pagos a un proveedor, en orden. Es lo que muestra la ficha.
  @@index([supplierId, paidAt])
  /// El reporte de pagos de la sucursal.
  @@index([branchId, paidAt])
  @@index([cashShiftId])
  @@index([paidById])
}

/// Que obligacion cancelo cada peso de un pago. Fase 4B.
///
/// El saldo del proveedor ya lo lleva el libro; esto responde otra pregunta,
/// que el saldo no puede responder: "de las cuatro entregas que nos quedaban
/// sin pagar, ¿cual salda este pago de $50.000?". Sin esto, un proveedor que
/// reclama la entrega del 12 obliga a reconstruir la imputacion de memoria.
///
/// La imputacion es DETALLE, no verdad: el saldo sale del libro y sigue
/// saliendo del libro aunque un pago quede sin imputar. Esa asimetria es
/// deliberada y esta documentada en docs/SUPPLIER_PAYMENT_ALLOCATION.md: si la
/// imputacion fuera la fuente del saldo, un anticipo --plata entregada sin una
/// obligacion contra la cual imputarse-- no se podria registrar.
model SupplierPaymentAllocation {
  id        Int @id @default(autoincrement())
  paymentId Int
  receiptId Int

  /// Cuanto de ESTE pago se imputa a ESA obligacion. Siempre positivo.
  amount Decimal @db.Decimal(14, 2)

  /// Quien la escribio. Fase 4C.
  ///
  /// En la Fase 4B no hacia falta: toda imputacion nacia dentro de la
  /// transaccion de su pago, asi que quien imputaba era siempre quien pagaba.
  /// La imputacion DIFERIDA rompe eso --un anticipo de marzo se aplica a una
  /// entrega de agosto, y puede hacerlo otra persona-- y sin esta columna la
  /// fila no dice quien tomo esa decision.
  ///
  /// La migracion rellena las filas anteriores con `SupplierPayment.paidById`,
  /// que es exactamente quien las escribio.
  createdById Int

  createdAt DateTime @default(now())

  payment   SupplierPayment @relation(fields: [paymentId], references: [id])
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])

  /// "Cuanto puso este pago" y "cuanto lleva pagado esta entrega", que son las
  /// dos preguntas del modulo.
  ///
  /// El primero era UNICO hasta la Fase 4C, y dejo de serlo por la imputacion
  /// diferida: un anticipo de $50.000 puede cubrir $30.000 de una entrega hoy y
  /// los $20.000 restantes de la misma entrega la semana que viene, cuando el
  /// proveedor mande la nota que faltaba. Con el par unico, esa segunda
  /// imputacion era imposible --y el dinero quedaba varado sin forma de
  /// aplicarlo-- porque una imputacion no se edita.
  ///
  /// Lo que se pierde: "cuanto le puso este pago a esta entrega" pasa a ser una
  /// suma en vez de una fila. Lo que se gana: cada fila sigue siendo un hecho
  /// inmutable con su fecha y su autor, que es exactamente como este sistema
  /// responde el saldo de un proveedor y el stock de un producto. Ver
  /// docs/SUPPLIER_PAYMENT_ALLOCATION.md.
  @@index([paymentId])
  @@index([receiptId])
  @@index([createdById])
}

/// Una devolucion de mercaderia al proveedor. Fase 4C.
///
/// Es UN HECHO FISICO con consecuencias financieras, y por eso es una entidad y
/// no un movimiento del libro: sale mercaderia del deposito, y lo que sale hay
/// que poder decirlo producto por producto y a que costo.
///
/// SIEMPRE APUNTA A UNA RECEPCION, y no es una limitacion sino la definicion:
/// devolver es deshacer parte de una entrega concreta. De ahi salen las tres
/// cosas que hacen falta y que no se pueden inventar: el costo con el que entro,
/// cuanto entro --que es el tope de lo que puede volver-- y en que unidad. Una
/// correccion financiera SIN mercaderia --una diferencia de facturacion, un
/// descuento pactado despues-- ya tiene su camino desde la Fase 4B y se llama
/// nota de credito.
///
/// Ver docs/PURCHASE_RETURN_FLOW.md y docs/PURCHASE_RETURN_ACCOUNTING.md.
model PurchaseReturn {
  id Int @id @default(autoincrement())

  /// "DV-00000124". Lo genera el SERVIDOR con una secuencia de PostgreSQL,
  /// igual que `OC-`, `RC-`, `PP-` y `CB-`, y por el mismo motivo:
  /// `count() + 1` hace que dos devoluciones simultaneas pidan el mismo numero.
  number String @unique

  branchId   Int
  supplierId Int

  /// La entrega que se esta deshaciendo. Ver arriba: nunca es nula.
  ///
  /// Redundante con `PurchaseReturnItem.purchaseReceiptItemId` --las lineas
  /// apuntan a las de la recepcion-- y guardada igual, porque es la cabecera la
  /// que se lista, se filtra y se enlaza. Que las lineas sean de ESTA recepcion
  /// lo comprueba el servicio.
  purchaseReceiptId Int

  /// DRAFT | CONFIRMED | CANCELLED.
  ///
  /// DRAFT no mueve NADA: ni stock ni saldo. Es un papel que se esta armando, y
  /// por eso dos borradores pueden pedir la misma mercaderia sin chocar: el tope
  /// de lo retornable se consume al CONFIRMAR, que es cuando la mercaderia sale.
  ///
  /// CONFIRMED es inmutable, con disparador. CANCELLED solo se alcanza desde
  /// DRAFT: una devolucion confirmada no se cancela, se compensa con una
  /// recepcion nueva si el proveedor la devuelve.
  status String @default("DRAFT")

  /// DAMAGED | WRONG_PRODUCT | QUALITY | OVER_DELIVERY | OTHER. Obligatorio.
  ///
  /// El enum es para poder PREGUNTAR --"cuanto devolvimos por rotura este
  /// trimestre"-- y `notes` es para lo que el enum no puede decir. Los dos, y no
  /// uno: solo el enum obliga a elegir "OTHER" y perder el motivo real; solo el
  /// texto hace que la pregunta se conteste leyendo.
  reason String

  notes String?

  /// Lo que esta devolucion vale, AL COSTO HISTORICO de la recepcion original.
  ///
  /// Suma de `amount` de sus lineas. Lo calcula el servidor. Es el importe del
  /// `PURCHASE_CREDIT` que se emite al confirmar, y se guarda por lo mismo que
  /// `PurchaseReceipt.total`: es el numero por el que se lista y se ordena.
  ///
  /// En DRAFT se recalcula con cada cambio de lineas; al confirmar queda
  /// congelado con la fila entera.
  total Decimal @default(0) @db.Decimal(14, 2)

  createdById Int
  createdAt   DateTime @default(now())

  confirmedById Int?
  confirmedAt   DateTime?

  cancelledById Int?
  cancelledAt   DateTime?
  cancelReason  String?

  branch      Branch          @relation(fields: [branchId], references: [id])
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  receipt     PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id])
  createdBy   User            @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id])
  confirmedBy User?           @relation("PurchaseReturnConfirmedBy", fields: [confirmedById], references: [id])
  cancelledBy User?           @relation("PurchaseReturnCancelledBy", fields: [cancelledById], references: [id])

  items     PurchaseReturnItem[]
  movements SupplierAccountMovement[]

  /// El listado de la sucursal, filtrando por estado.
  @@index([branchId, status, createdAt])
  /// "Que le devolvimos a este proveedor", que es la seccion de su ficha.
  @@index([supplierId, createdAt])
  /// "Que se devolvio de esta entrega", que es el tope de lo retornable y el
  /// descuento de la obligacion.
  @@index([purchaseReceiptId])
  @@index([createdById])
}

/// Un renglon de una devolucion: que producto vuelve, cuanto y a que costo.
model PurchaseReturnItem {
  id               Int @id @default(autoincrement())
  purchaseReturnId Int
  productId        Int

  /// La linea de la recepcion que se esta deshaciendo. Nunca nula.
  ///
  /// De aca salen las tres cosas que esta fila NO inventa: el costo unitario
  /// congelado, la unidad de compra y el tope de lo retornable.
  purchaseReceiptItemId Int

  /// EN UNIDAD DE COMPRA. "2 cajas".
  quantity Decimal @db.Decimal(14, 3)

  /// Copiadas de la linea de la recepcion, que a su vez las congelo del
  /// producto. Guardadas y no leidas al vuelo por lo mismo que en la recepcion:
  /// si el producto cambia de "caja de 8" a "caja de 12", esta devolucion siguio
  /// siendo de cajas de 8.
  purchaseUnit         String
  unitsPerPurchaseUnit Decimal @db.Decimal(14, 3)

  /// EN UNIDAD DE VENTA: quantity x unitsPerPurchaseUnit. Es lo que SALE del
  /// stock, y por eso se guarda: el movimiento de inventario tiene que poder
  /// explicarse desde esta fila sin rehacer la conversion.
  stockQuantity Decimal @db.Decimal(14, 3)

  /// Costo por unidad de compra, COPIADO DE LA RECEPCION ORIGINAL.
  ///
  /// NO de `Product.cost`, que es el costo de hoy. Si la caja entro a $1.100 y
  /// hoy sale $1.350, devolverla vale $1.100: el proveedor acredita lo que
  /// cobro. Usar el costo actual seria reescribir el pasado, y ademas
  /// convertiria cada aumento de precios en una ganancia por devolver.
  unitCost Decimal @db.Decimal(14, 4)

  /// quantity x unitCost, redondeado a pesos. El credito de esta linea.
  amount Decimal @db.Decimal(14, 2)

  /// De que LOTE vuelve la mercaderia. Fase 4D.
  ///
  /// Nulo para los productos sin rastreo, que son todos los de antes de la Fase
  /// 4D. Obligatorio para los `REQUIRED`, y NO se puede elegir cualquiera: tiene
  /// que ser uno de los lotes CON LOS QUE LLEGO ESA LINEA. Devolver del lote
  /// equivocado sacaria mercaderia de una partida que el proveedor nunca mando y
  /// dejaria en el deposito la que hay que sacar.
  lotId Int?

  return      PurchaseReturn      @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id])
  receiptItem PurchaseReceiptItem @relation(fields: [purchaseReceiptItemId], references: [id])

  /// RESTRICT y no el `SetNull` que Prisma pone por omision en una relacion
  /// opcional. Con `SetNull`, borrar un lote dejaria el renglon en pie diciendo
  /// que devolvio "algo" sin decir de que partida: el credito al proveedor
  /// seguiria ahi y la trazabilidad no. Un lote referenciado no se borra.
  lot ProductLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  /// Un renglon por (linea de recepcion, lote).
  ///
  /// En la Fase 4C esto era `(devolucion, linea)` a secas, y tuvo que aflojarse:
  /// una linea que llego repartida en dos partidas se devuelve entera con DOS
  /// renglones, uno por lote. Con la clave anterior, devolver las dos partidas
  /// obligaria a armar dos devoluciones distintas para una sola devolucion
  /// fisica. El caso con `lotId` nulo lo cubre un indice unico parcial, porque
  /// PostgreSQL considera dos NULL distintos entre si.
  @@unique([purchaseReturnId, purchaseReceiptItemId, lotId], map: "PurchaseReturnItem_devolucion_linea_lote_key")
  @@index([purchaseReturnId])
  @@index([productId])
  /// "Cuanto se devolvio ya de esta linea", que es el tope de lo retornable.
  @@index([purchaseReceiptItemId])
  @@index([lotId])
}

model Sale {
  id         Int      @id @default(autoincrement())
  userId     Int
  branchId   Int
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  isVerified Boolean  @default(false)

  /// "completed" | "canceled". Una venta nunca se borra: se anula.
  status       String    @default("completed")
  canceledAt   DateTime?
  canceledById Int?
  cancelReason String?

  /// Total cobrado.
  ///
  /// Se guarda y no se deriva de los items porque es contra ESTE numero que se
  /// comprueba la suma de los pagos. Derivarlo en cada lectura significaria
  /// que la comprobacion "suma de pagos == total" depende de recalcular el
  /// total igual que cuando se cobro --mismo redondeo, mismo orden-- y eso es
  /// exactamente lo que no se puede garantizar dos anios despues.
  total Decimal @default(0) @db.Decimal(14, 2)

  /// A quien se le vendio. NULL es lo normal y va a seguir siendolo.
  ///
  /// Un almacen no le pide el nombre a quien compra un paquete de yerba, y
  /// obligar a identificar a todo comprador convertiria la venta rapida en un
  /// tramite. Todas las ventas anteriores a la Fase 4A quedan en NULL, y eso
  /// NO significa "cliente desconocido": significa venta al mostrador.
  ///
  /// La unica excepcion la impone el servidor: una venta con saldo a cuenta SI
  /// exige cliente, porque una deuda sin deudor no se puede cobrar. Ver
  /// docs/CREDIT_POLICY.md.
  clientId Int?

  items         SaleItem[]
  payments      SalePayment[]
  cashMovements CashRegisterMovement[]
  accountMoves  CustomerAccountMovement[]
  user          User                      @relation("SaleCreatedBy", fields: [userId], references: [id])
  canceledBy    User?                     @relation("SaleCanceledBy", fields: [canceledById], references: [id])
  branch        Branch                    @relation(fields: [branchId], references: [id])

  /// RESTRICT y no el `SetNull` que Prisma pone por omision en una relacion
  /// opcional. La diferencia importa: con `SetNull`, borrar un cliente dejaria
  /// sus ventas en pie pero sin dueno, y una venta que decia "de Juan" pasaria
  /// a decir "del mostrador" sin que nadie se entere. Con RESTRICT, el cliente
  /// con ventas simplemente no se puede borrar --se da de baja--, que es la
  /// misma regla que ya rige para productos y proveedores.
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([branchId, date])
  @@index([status])
  /// Las ventas de un cliente, que es una de las tres listas de su ficha.
  @@index([clientId, date])
}

model SaleItem {
  id        Int @id @default(autoincrement())
  saleId    Int
  productId Int

  /// Cantidad vendida, en la unidad de venta del producto. `Decimal(14,3)`
  /// desde la Fase 3B: 0,425 kg de queso es una linea de ticket valida.
  quantity Decimal @db.Decimal(14, 3)

  /// Precio congelado en el momento de vender. Cambiar el precio del producto
  /// no reescribe las ventas de ayer.
  price Decimal @db.Decimal(14, 2)

  /// Cuanto COSTABA cuando se vendio. Congelado, igual que el precio.
  ///
  /// Sin esto, la rentabilidad historica se calcularia con el costo ACTUAL, y
  /// eso la vuelve una cifra falsa: una Coca vendida el lunes a $1.500 con un
  /// costo de $1.000 dejo $500. Si el viernes llega mercaderia a $1.300, la
  /// ganancia del lunes NO puede pasar a $200 --el lunes ya paso--. El costo de
  /// una venta es un hecho de esa venta, no del producto.
  ///
  /// NULL significa "no se sabia": el catalogo migrado arranca sin costo y hay
  /// productos que nunca lo tuvieron. No se rellena con el costo de hoy, que
  /// seria inventar el numero que este campo existe para no inventar. Los
  /// informes de rentabilidad excluyen esas lineas y dicen cuantas fueron.
  ///
  /// Cuatro decimales, como `Product.cost`: se copia tal cual.
  costAtSale Decimal? @db.Decimal(14, 4)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  lots SaleItemLotAllocation[]

  /// La rentabilidad recorre las lineas de un rango de ventas.
  @@index([productId])
}

/// De que lotes salio una linea de venta. Fase 4D.
///
/// Una venta de 5 yogures puede tomar 3 del lote que vence manana y 2 del que
/// vence en diez dias. `SaleItem.quantity` sigue diciendo 5 --NO se parte en dos
/// lineas de ticket-- y esto dice de donde salieron.
///
/// Es lo que hace posible la anulacion honesta: devolver a los MISMOS lotes de
/// los que se saco, sin recalcular FEFO diez dias despues, cuando el lote que
/// vencia manana ya vencio.
model SaleItemLotAllocation {
  id         Int @id @default(autoincrement())
  saleItemId Int
  lotId      Int

  /// EN UNIDAD DE VENTA, positiva. El signo lo pone el movimiento de stock.
  quantity Decimal @db.Decimal(14, 3)

  saleItem SaleItem   @relation(fields: [saleItemId], references: [id])
  lot      ProductLot @relation(fields: [lotId], references: [id])

  @@unique([saleItemId, lotId])
  @@index([lotId])
}

/// Un pago de una venta. Una venta puede tener varios.
///
/// Reemplaza al `paymentMethod` unico que vivia dentro del movimiento de caja.
/// La regla que hace util la entidad: LA SUMA DE LOS PAGOS ES EXACTAMENTE EL
/// TOTAL DE LA VENTA. Con `Float` esa igualdad fallaba sola; por eso el dinero
/// se migro a Decimal antes que esto.
model SalePayment {
  id     Int @id @default(autoincrement())
  saleId Int

  /// 'CASH' | 'DEBIT_CARD' | 'CREDIT_CARD' | 'TRANSFER' | 'OTHER' | 'CARD' |
  /// 'ACCOUNT'. Ver src/modules/sales/payment-methods.ts. `CARD` es historico.
  ///
  /// `ACCOUNT` desde la Fase 4A: es la parte de la venta que NO se cobro y
  /// quedo en la cuenta del cliente. Existe aca --y no como una entidad
  /// aparte-- para no romper la invariante que hace util a esta tabla:
  ///
  ///   suma(SalePayment.amount) == Sale.total,  siempre
  ///
  /// Una venta de $32.000 con $12.000 en efectivo y $20.000 fiados sigue
  /// sumando $32.000. Lo que cambia es a DONDE va cada linea: el efectivo al
  /// cajon, la cuenta al libro del cliente. `ACCOUNT` NO genera movimiento de
  /// caja: no es plata que entro, es una promesa.
  method String

  amount Decimal @db.Decimal(14, 2)

  /// Con cuanto pago y cuanto se le dio de vuelto. Solo tienen sentido en
  /// efectivo: no se puede recibir de mas en una transferencia.
  cashReceived Decimal? @db.Decimal(14, 2)
  changeGiven  Decimal? @db.Decimal(14, 2)

  /// Numero de operacion, ultimos digitos del cupon, lo que quede a mano.
  /// NUNCA el numero completo de la tarjeta ni el codigo de seguridad: en esta
  /// fase el sistema no procesa tarjetas, solo anota como se cobro.
  reference String?

  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([method])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  tableName  String
  recordId   Int?
  actionType String
  changes    Json?
  origin     String?
  timestamp  DateTime @default(now())

  /// Sucursal en la que ocurrio. Se copia del evento y no se deduce del
  /// usuario: un traslado de sucursal no debe reescribir la historia.
  branchId Int?

  /// Identificador de la peticion. Une esta fila con la linea del log del
  /// servidor y con el error que vio el usuario.
  requestId String?

  /// Direccion de origen. Hasta 45 caracteres: una IPv6 con zona.
  ip String? @db.VarChar(45)

  /// Motivo declarado por el usuario, cuando la operacion lo exige
  /// (anulacion, ajuste de stock).
  reason String?

  /// 'success' | 'failure'. Un intento rechazado tambien se audita.
  result String @default("success")

  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId, timestamp])
  @@index([tableName, actionType, timestamp])
  @@index([requestId])
}

model CashRegisterMovement {
  id       Int @id @default(autoincrement())
  branchId Int
  userId   Int

  /// Importe con signo: positivo entra, negativo sale. El signo lo decide el
  /// servidor a partir del tipo, nunca el cliente.
  amount Decimal @db.Decimal(14, 2)

  paymentMethod String
  description   String?
  date          DateTime @default(now())
  type          String

  /// Vinculo explicito con la venta. Reemplaza el parseo de "Venta #123"
  /// sobre el campo description, que era la unica forma de relacionarlos.
  saleId Int?

  /// Vinculo explicito con el cobro a un cliente, cuando el movimiento vino de
  /// uno. Existe por el mismo motivo que `saleId`, y se agrego en la misma
  /// migracion que lo necesitaba: sin esto, la reconciliacion tendria que
  /// buscar el comprobante dentro de `description` con un LIKE, que es
  /// exactamente el parseo de texto que este campo vino a eliminar en la
  /// Fase 3. Un `description` es para leer, no para unir tablas.
  customerPaymentId Int?

  /// Vinculo explicito con el pago a un proveedor, cuando el movimiento vino de
  /// uno. Fase 4B, y por el mismo motivo que los dos de arriba: la
  /// reconciliacion de "pago en efectivo a proveedor tiene su egreso de caja"
  /// une las dos tablas por esta columna y no por un LIKE sobre la descripcion.
  supplierPaymentId Int?

  /// Turno en el que ocurrio. Null solo en los movimientos anteriores a que
  /// existieran los turnos, que la migracion cuelga del turno `legacy`.
  shiftId Int?

  branch          Branch           @relation(fields: [branchId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  sale            Sale?            @relation(fields: [saleId], references: [id])
  shift           CashShift?       @relation(fields: [shiftId], references: [id])
  customerPayment CustomerPayment? @relation(fields: [customerPaymentId], references: [id])
  supplierPayment SupplierPayment? @relation(fields: [supplierPaymentId], references: [id])

  @@index([branchId, date])
  @@index([saleId])
  @@index([customerPaymentId])
  @@index([supplierPaymentId])
  /// El saldo esperado de un turno suma los movimientos en efectivo de ESE
  /// turno. Es la consulta que se hace en cada venta y en cada cierre.
  @@index([shiftId, paymentMethod])
}

model CashCount {
  id       Int      @id @default(autoincrement())
  branchId Int
  userId   Int
  /// Lo que se conto fisicamente en el cajon.
  amount   Decimal  @db.Decimal(14, 2)
  date     DateTime @default(now())
  notes    String? // notas u observaciones opcionales

  /// Lo que el sistema esperaba. Lo calcula el servidor, nunca el cliente.
  expected Decimal @default(0) @db.Decimal(14, 2)

  /// contado - esperado. Positivo sobra, negativo falta.
  ///
  /// Se guarda calculado y no se deduce al leer: asi se puede preguntar por
  /// "arqueos con diferencia" sin recorrer texto. Antes los dos valores
  /// vivian dentro de `notes` como una frase.
  difference Decimal @default(0) @db.Decimal(14, 2)

  /// Turno contra el que se hizo el arqueo. Null en los arqueos anteriores a
  /// que existieran los turnos, que la migracion cuelga del turno `legacy`.
  ///
  /// Un arqueo NO cierra el turno: es un recuento intermedio. El cierre es
  /// otra operacion, con su propia confirmacion.
  shiftId Int?

  branch Branch     @relation(fields: [branchId], references: [id])
  user   User       @relation(fields: [userId], references: [id])
  shift  CashShift? @relation(fields: [shiftId], references: [id])

  @@index([branchId, date])
  @@index([shiftId])
}
